# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# Ne JAMAIS committer le fichier ".env" réel (il est dans .gitignore).

MISTRAL_API_KEY=votre_cle_api_mistral

# --- Base de données MySQL (versioning des schémas BPMN) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=votre_utilisateur_mysql
DB_PASSWORD=votre_mot_de_passe_mysql
DB_NAME=bpmn
