{
  "process": {
    "id": "process_vente_immobiliere",
    "name": "Processus de vente immobilière",
    "isExecutable": true
  },
  "pools": [
    {
      "id": "pool_notaire",
      "name": "Notaire",
      "lanes": []
    },
    {
      "id": "pool_acheteur",
      "name": "Acheteur",
      "lanes": []
    }
  ],
  "nodes": [
    {
      "id": "start_event_vente",
      "type": "startEvent",
      "name": "Début du processus de vente",
      "eventDefinition": "none",
      "poolId": "pool_notaire"
    },
    {
      "id": "task_signature_acte",
      "type": "task",
      "name": "Signer l'acte notarié",
      "poolId": "pool_notaire"
    },
    {
      "id": "task_transfert_fonds",
      "type": "task",
      "name": "Transférer les fonds",
      "poolId": "pool_acheteur",
      "documentation": "GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool 'pool_acheteur' ; cohérence métier non garantie, à vérifier."
    },
    {
      "id": "task_transmission_decision_reussi",
      "type": "task",
      "name": "Transmettre le résultat du transfert (succès)",
      "poolId": "pool_notaire"
    },
    {
      "id": "task_transmission_decision_echec",
      "type": "task",
      "name": "Transmettre le résultat du transfert (échec)",
      "poolId": "pool_notaire"
    },
    {
      "id": "task_annulation_etapes",
      "type": "task",
      "name": "Annuler les étapes précédentes",
      "poolId": "pool_notaire"
    },
    {
      "id": "task_finalisation_vente",
      "type": "task",
      "name": "Finaliser la vente",
      "poolId": "pool_notaire"
    },
    {
      "id": "task_notifier_transfert_reussi",
      "type": "task",
      "name": "Notifier le résultat du transfert (succès)",
      "poolId": "pool_acheteur"
    },
    {
      "id": "task_notifier_transfert_echec",
      "type": "task",
      "name": "Notifier le résultat du transfert (échec)",
      "poolId": "pool_acheteur"
    },
    {
      "id": "end_event_vente_finalisee",
      "type": "endEvent",
      "name": "Vente finalisée",
      "eventDefinition": "none",
      "poolId": "pool_notaire"
    },
    {
      "id": "gateway_transfert",
      "type": "exclusiveGateway",
      "name": "Résultat du transfert des fonds",
      "gatewayDirection": "diverging",
      "poolId": "pool_acheteur"
    }
  ],
  "edges": [
    {
      "id": "flow_start_signature",
      "source": "start_event_vente",
      "target": "task_signature_acte",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_signature_transfert",
      "source": "task_signature_acte",
      "target": "task_transfert_fonds",
      "type": "messageFlow",
      "name": "Acte signé"
    },
    {
      "id": "flow_transfert_gateway",
      "source": "task_transfert_fonds",
      "target": "gateway_transfert",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_gateway_reussi_notif",
      "source": "gateway_transfert",
      "target": "task_notifier_transfert_reussi",
      "type": "sequenceFlow",
      "name": "Transfert réussi"
    },
    {
      "id": "flow_notif_reussi_transmission",
      "source": "task_notifier_transfert_reussi",
      "target": "task_transmission_decision_reussi",
      "type": "messageFlow",
      "name": "Notification de succès"
    },
    {
      "id": "flow_gateway_echec_notif",
      "source": "gateway_transfert",
      "target": "task_notifier_transfert_echec",
      "type": "sequenceFlow",
      "name": "Transfert échoué"
    },
    {
      "id": "flow_notif_echec_transmission",
      "source": "task_notifier_transfert_echec",
      "target": "task_transmission_decision_echec",
      "type": "messageFlow",
      "name": "Notification d'échec"
    },
    {
      "id": "flow_transmission_reussi_finalisation",
      "source": "task_transmission_decision_reussi",
      "target": "task_finalisation_vente",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_finalisation_fin",
      "source": "task_finalisation_vente",
      "target": "end_event_vente_finalisee",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_transmission_echec_annulation",
      "source": "task_transmission_decision_echec",
      "target": "task_annulation_etapes",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_annulation_signature",
      "source": "task_annulation_etapes",
      "target": "task_signature_acte",
      "type": "sequenceFlow",
      "name": "Annuler signature"
    }
  ]
}