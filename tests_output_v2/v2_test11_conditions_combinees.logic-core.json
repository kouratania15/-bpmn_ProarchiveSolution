{
  "process": {
    "id": "process_credit_card_application",
    "name": "Étude de demande de carte de crédit",
    "documentation": "Processus d'évaluation d'une demande de carte de crédit par un agent bancaire basé sur le revenu et l'historique de crédit."
  },
  "pools": [
    {
      "id": "bank_pool",
      "name": "Banque",
      "lanes": []
    }
  ],
  "nodes": [
    {
      "id": "start_event",
      "type": "startEvent",
      "name": "Demande de carte de crédit reçue",
      "eventDefinition": "none",
      "poolId": "bank_pool"
    },
    {
      "id": "task_study_request",
      "type": "task",
      "name": "Étudier la demande de carte de crédit",
      "poolId": "bank_pool"
    },
    {
      "id": "task_check_income",
      "type": "task",
      "name": "Vérifier si le revenu est suffisant",
      "poolId": "bank_pool"
    },
    {
      "id": "task_check_credit_history",
      "type": "task",
      "name": "Vérifier si l'historique de crédit est bon",
      "poolId": "bank_pool"
    },
    {
      "id": "task_check_income_split_gw",
      "type": "exclusiveGateway",
      "name": "Revenu suffisant ?",
      "gatewayDirection": "diverging",
      "poolId": "bank_pool"
    },
    {
      "id": "gateway_decision",
      "type": "inclusiveGateway",
      "name": "Conditions remplies ?",
      "gatewayDirection": "diverging",
      "poolId": "bank_pool"
    },
    {
      "id": "task_approve_high_limit",
      "type": "task",
      "name": "Approuver la carte avec un plafond élevé",
      "poolId": "bank_pool"
    },
    {
      "id": "task_approve_low_limit",
      "type": "task",
      "name": "Approuver la carte avec un plafond réduit",
      "poolId": "bank_pool"
    },
    {
      "id": "task_reject_request",
      "type": "task",
      "name": "Rejeter la demande de carte de crédit",
      "poolId": "bank_pool"
    },
    {
      "id": "end_event_approve_high",
      "type": "endEvent",
      "name": "Carte approuvée avec plafond élevé",
      "eventDefinition": "none",
      "poolId": "bank_pool"
    },
    {
      "id": "end_event_approve_low",
      "type": "endEvent",
      "name": "Carte approuvée avec plafond réduit",
      "eventDefinition": "none",
      "poolId": "bank_pool"
    },
    {
      "id": "end_event_rejected",
      "type": "endEvent",
      "name": "Demande rejetée",
      "eventDefinition": "none",
      "poolId": "bank_pool"
    }
  ],
  "edges": [
    {
      "id": "flow_start_to_study",
      "source": "start_event",
      "target": "task_study_request",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_study_to_check_income",
      "source": "task_study_request",
      "target": "task_check_income",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_check_income_to_gateway_income",
      "source": "task_check_income",
      "target": "task_check_income_split_gw",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_check_income_split_gw_to_check_history",
      "source": "task_check_income_split_gw",
      "target": "task_check_credit_history",
      "type": "sequenceFlow",
      "name": "Revenu insuffisant"
    },
    {
      "id": "flow_check_income_split_gw_to_gateway_decision",
      "source": "task_check_income_split_gw",
      "target": "gateway_decision",
      "type": "sequenceFlow",
      "name": "Revenu suffisant"
    },
    {
      "id": "flow_check_history_to_gateway_decision",
      "source": "task_check_credit_history",
      "target": "gateway_decision",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_gateway_to_approve_high",
      "source": "gateway_decision",
      "target": "task_approve_high_limit",
      "type": "sequenceFlow",
      "name": "Les deux conditions remplies",
      "isDefault": false
    },
    {
      "id": "flow_gateway_to_approve_low",
      "source": "gateway_decision",
      "target": "task_approve_low_limit",
      "type": "sequenceFlow",
      "name": "Une seule condition remplie",
      "isDefault": false
    },
    {
      "id": "flow_gateway_to_reject",
      "source": "gateway_decision",
      "target": "task_reject_request",
      "type": "sequenceFlow",
      "name": "Aucune condition remplie",
      "isDefault": true
    },
    {
      "id": "flow_approve_high_to_end",
      "source": "task_approve_high_limit",
      "target": "end_event_approve_high",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_approve_low_to_end",
      "source": "task_approve_low_limit",
      "target": "end_event_approve_low",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_reject_to_end",
      "source": "task_reject_request",
      "target": "end_event_rejected",
      "type": "sequenceFlow"
    }
  ]
}