<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_preparation_lancement"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_process_preparation_lancement">
    <bpmn:participant id="pool_agence_communication" name="Agence de communication" processRef="process_preparation_lancement" />
  </bpmn:collaboration>
  <bpmn:process id="process_preparation_lancement" name="Agence de communication" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_redaction" name="Rédaction">
        <bpmn:flowNodeRef>task_rediger_communique</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_design" name="Design">
        <bpmn:flowNodeRef>task_concevoir_visuels</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_relations" name="Relations publiques">
        <bpmn:flowNodeRef>task_contacter_influenceurs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_developpement" name="Développement web">
        <bpmn:flowNodeRef>task_preparer_page_vente</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_preparation" name="Début de la préparation du lancement">
      <bpmn:outgoing>flow_start_gateway</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="gateway_parallel" name="Démarrage des tâches parallèles">
      <bpmn:documentation>GAP: parallélisme explicite conservé; la normalisation ne doit pas inventer de décision exclusive sans preuve métier.</bpmn:documentation>
      <bpmn:incoming>flow_start_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_rediger</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_concevoir</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_contacter</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_preparer</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="task_rediger_communique" name="Rédiger le communiqué de presse">
      <bpmn:incoming>flow_gateway_rediger</bpmn:incoming>
      <bpmn:outgoing>flow_rediger_convergence</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_concevoir_visuels" name="Concevoir les visuels publicitaires">
      <bpmn:incoming>flow_gateway_concevoir</bpmn:incoming>
      <bpmn:outgoing>flow_concevoir_convergence</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_contacter_influenceurs" name="Contacter les influenceurs">
      <bpmn:incoming>flow_gateway_contacter</bpmn:incoming>
      <bpmn:outgoing>flow_contacter_convergence</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_preparer_page_vente" name="Préparer la page de vente en ligne">
      <bpmn:incoming>flow_gateway_preparer</bpmn:incoming>
      <bpmn:outgoing>flow_preparer_convergence</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="gateway_convergence" name="Convergence des tâches parallèles">
      <bpmn:documentation>GAP: parallélisme explicite conservé; la normalisation ne doit pas inventer de décision exclusive sans preuve métier.</bpmn:documentation>
      <bpmn:incoming>flow_rediger_convergence</bpmn:incoming>
      <bpmn:incoming>flow_concevoir_convergence</bpmn:incoming>
      <bpmn:incoming>flow_contacter_convergence</bpmn:incoming>
      <bpmn:incoming>flow_preparer_convergence</bpmn:incoming>
      <bpmn:outgoing>flow_convergence_end</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="end_lancement_pret" name="Lancement prêt">
      <bpmn:incoming>flow_convergence_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_gateway" name="" sourceRef="start_preparation" targetRef="gateway_parallel">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_rediger" name="" sourceRef="gateway_parallel" targetRef="task_rediger_communique">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_concevoir" name="" sourceRef="gateway_parallel" targetRef="task_concevoir_visuels">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_contacter" name="" sourceRef="gateway_parallel" targetRef="task_contacter_influenceurs">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_preparer" name="" sourceRef="gateway_parallel" targetRef="task_preparer_page_vente">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_rediger_convergence" name="" sourceRef="task_rediger_communique" targetRef="gateway_convergence">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_concevoir_convergence" name="" sourceRef="task_concevoir_visuels" targetRef="gateway_convergence">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_contacter_convergence" name="" sourceRef="task_contacter_influenceurs" targetRef="gateway_convergence">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_preparer_convergence" name="" sourceRef="task_preparer_page_vente" targetRef="gateway_convergence">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_convergence_end" name="" sourceRef="gateway_convergence" targetRef="end_lancement_pret">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_preparation_lancement">
      <bpmndi:BPMNShape id="pool_agence_communication_di" bpmnElement="pool_agence_communication" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="900" height="760" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_redaction_di" bpmnElement="lane_redaction" isHorizontal="true">
        <dc:Bounds x="90" y="50" width="870" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_design_di" bpmnElement="lane_design" isHorizontal="true">
        <dc:Bounds x="90" y="240" width="870" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_relations_di" bpmnElement="lane_relations" isHorizontal="true">
        <dc:Bounds x="90" y="430" width="870" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_developpement_di" bpmnElement="lane_developpement" isHorizontal="true">
        <dc:Bounds x="90" y="620" width="870" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_preparation_di" bpmnElement="start_preparation">
        <dc:Bounds x="120" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_parallel_di" bpmnElement="gateway_parallel">
        <dc:Bounds x="280" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_rediger_communique_di" bpmnElement="task_rediger_communique">
        <dc:Bounds x="440" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_concevoir_visuels_di" bpmnElement="task_concevoir_visuels">
        <dc:Bounds x="440" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_contacter_influenceurs_di" bpmnElement="task_contacter_influenceurs">
        <dc:Bounds x="440" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_preparer_page_vente_di" bpmnElement="task_preparer_page_vente">
        <dc:Bounds x="440" y="660" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_convergence_di" bpmnElement="gateway_convergence">
        <dc:Bounds x="600" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_lancement_pret_di" bpmnElement="end_lancement_pret">
        <dc:Bounds x="760" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_gateway_di" bpmnElement="flow_start_gateway">
        <di:waypoint x="156" y="98" />
        <di:waypoint x="218" y="98" />
        <di:waypoint x="218" y="105" />
        <di:waypoint x="280" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_rediger_di" bpmnElement="flow_gateway_rediger">
        <di:waypoint x="330" y="105" />
        <di:waypoint x="385" y="105" />
        <di:waypoint x="385" y="130" />
        <di:waypoint x="440" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_concevoir_di" bpmnElement="flow_gateway_concevoir">
        <di:waypoint x="330" y="105" />
        <di:waypoint x="385" y="105" />
        <di:waypoint x="385" y="320" />
        <di:waypoint x="440" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_contacter_di" bpmnElement="flow_gateway_contacter">
        <di:waypoint x="330" y="105" />
        <di:waypoint x="385" y="105" />
        <di:waypoint x="385" y="510" />
        <di:waypoint x="440" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_preparer_di" bpmnElement="flow_gateway_preparer">
        <di:waypoint x="330" y="105" />
        <di:waypoint x="385" y="105" />
        <di:waypoint x="385" y="700" />
        <di:waypoint x="440" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rediger_convergence_di" bpmnElement="flow_rediger_convergence">
        <di:waypoint x="540" y="130" />
        <di:waypoint x="570" y="130" />
        <di:waypoint x="570" y="105" />
        <di:waypoint x="600" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_concevoir_convergence_di" bpmnElement="flow_concevoir_convergence">
        <di:waypoint x="540" y="320" />
        <di:waypoint x="570" y="320" />
        <di:waypoint x="570" y="105" />
        <di:waypoint x="600" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_contacter_convergence_di" bpmnElement="flow_contacter_convergence">
        <di:waypoint x="540" y="510" />
        <di:waypoint x="570" y="510" />
        <di:waypoint x="570" y="105" />
        <di:waypoint x="600" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_preparer_convergence_di" bpmnElement="flow_preparer_convergence">
        <di:waypoint x="540" y="700" />
        <di:waypoint x="570" y="700" />
        <di:waypoint x="570" y="105" />
        <di:waypoint x="600" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_convergence_end_di" bpmnElement="flow_convergence_end">
        <di:waypoint x="650" y="105" />
        <di:waypoint x="705" y="105" />
        <di:waypoint x="705" y="98" />
        <di:waypoint x="760" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>