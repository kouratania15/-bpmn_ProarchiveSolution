<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_evaluation_projet"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_process_evaluation_projet">
    <bpmn:participant id="pool_jury" name="Jury d&#x27;experts" processRef="process_evaluation_projet" />
  </bpmn:collaboration>
  <bpmn:process id="process_evaluation_projet" name="Jury d&#x27;experts" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_expert_1" name="Expert 1">
        <bpmn:flowNodeRef>task_evaluer_projet_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_examiner_projet_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_attribuer_note_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_classer_projet</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_expert_2" name="Expert 2">
        <bpmn:flowNodeRef>task_evaluer_projet_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_examiner_projet_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_attribuer_note_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_expert_3" name="Expert 3">
        <bpmn:flowNodeRef>task_evaluer_projet_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_examiner_projet_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_attribuer_note_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_expert_4" name="Expert 4">
        <bpmn:flowNodeRef>task_evaluer_projet_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_examiner_projet_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_attribuer_note_4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_event" name="Début du processus d&#x27;évaluation">
      <bpmn:outgoing>flow_start_parallel</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_evaluer_projet_1" name="Évaluer le projet">
      <bpmn:incoming>flow_parallel_evaluer_1</bpmn:incoming>
      <bpmn:outgoing>flow_evaluer_examiner_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_examiner_projet_1" name="Examiner le projet indépendamment">
      <bpmn:incoming>flow_evaluer_examiner_1</bpmn:incoming>
      <bpmn:outgoing>flow_examiner_attribuer_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_attribuer_note_1" name="Attribuer une note">
      <bpmn:incoming>flow_examiner_attribuer_1</bpmn:incoming>
      <bpmn:outgoing>flow_attribuer_join_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_evaluer_projet_2" name="Évaluer le projet">
      <bpmn:incoming>flow_parallel_evaluer_2</bpmn:incoming>
      <bpmn:outgoing>flow_evaluer_examiner_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_examiner_projet_2" name="Examiner le projet indépendamment">
      <bpmn:incoming>flow_evaluer_examiner_2</bpmn:incoming>
      <bpmn:outgoing>flow_examiner_attribuer_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_attribuer_note_2" name="Attribuer une note">
      <bpmn:incoming>flow_examiner_attribuer_2</bpmn:incoming>
      <bpmn:outgoing>flow_attribuer_join_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_evaluer_projet_3" name="Évaluer le projet">
      <bpmn:incoming>flow_parallel_evaluer_3</bpmn:incoming>
      <bpmn:outgoing>flow_evaluer_examiner_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_examiner_projet_3" name="Examiner le projet indépendamment">
      <bpmn:incoming>flow_evaluer_examiner_3</bpmn:incoming>
      <bpmn:outgoing>flow_examiner_attribuer_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_attribuer_note_3" name="Attribuer une note">
      <bpmn:incoming>flow_examiner_attribuer_3</bpmn:incoming>
      <bpmn:outgoing>flow_attribuer_join_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_evaluer_projet_4" name="Évaluer le projet">
      <bpmn:incoming>flow_parallel_evaluer_4</bpmn:incoming>
      <bpmn:outgoing>flow_evaluer_examiner_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_examiner_projet_4" name="Examiner le projet indépendamment">
      <bpmn:incoming>flow_evaluer_examiner_4</bpmn:incoming>
      <bpmn:outgoing>flow_examiner_attribuer_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_attribuer_note_4" name="Attribuer une note">
      <bpmn:incoming>flow_examiner_attribuer_4</bpmn:incoming>
      <bpmn:outgoing>flow_attribuer_join_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="parallel_gateway" name="Déclenchement parallèle des évaluations">
      <bpmn:documentation>Justifié par le texte : &#x27;Chaque expert examine le projet indépendamment et attribue une note en parallèle.&#x27;</bpmn:documentation>
      <bpmn:incoming>flow_start_parallel</bpmn:incoming>
      <bpmn:outgoing>flow_parallel_evaluer_1</bpmn:outgoing>
      <bpmn:outgoing>flow_parallel_evaluer_2</bpmn:outgoing>
      <bpmn:outgoing>flow_parallel_evaluer_3</bpmn:outgoing>
      <bpmn:outgoing>flow_parallel_evaluer_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="parallel_join_gateway" name="Synchronisation des notes des experts">
      <bpmn:incoming>flow_attribuer_join_1</bpmn:incoming>
      <bpmn:incoming>flow_attribuer_join_2</bpmn:incoming>
      <bpmn:incoming>flow_attribuer_join_3</bpmn:incoming>
      <bpmn:incoming>flow_attribuer_join_4</bpmn:incoming>
      <bpmn:outgoing>flow_join_classer</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="task_classer_projet" name="Classer le projet">
      <bpmn:incoming>flow_join_classer</bpmn:incoming>
      <bpmn:outgoing>flow_classer_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_event" name="Classement finalisé">
      <bpmn:incoming>flow_classer_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_parallel" name="" sourceRef="start_event" targetRef="parallel_gateway">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_parallel_evaluer_1" name="" sourceRef="parallel_gateway" targetRef="task_evaluer_projet_1">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_evaluer_examiner_1" name="" sourceRef="task_evaluer_projet_1" targetRef="task_examiner_projet_1">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_examiner_attribuer_1" name="" sourceRef="task_examiner_projet_1" targetRef="task_attribuer_note_1">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_parallel_evaluer_2" name="" sourceRef="parallel_gateway" targetRef="task_evaluer_projet_2">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_evaluer_examiner_2" name="" sourceRef="task_evaluer_projet_2" targetRef="task_examiner_projet_2">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_examiner_attribuer_2" name="" sourceRef="task_examiner_projet_2" targetRef="task_attribuer_note_2">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_parallel_evaluer_3" name="" sourceRef="parallel_gateway" targetRef="task_evaluer_projet_3">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_evaluer_examiner_3" name="" sourceRef="task_evaluer_projet_3" targetRef="task_examiner_projet_3">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_examiner_attribuer_3" name="" sourceRef="task_examiner_projet_3" targetRef="task_attribuer_note_3">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_parallel_evaluer_4" name="" sourceRef="parallel_gateway" targetRef="task_evaluer_projet_4">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_evaluer_examiner_4" name="" sourceRef="task_evaluer_projet_4" targetRef="task_examiner_projet_4">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_examiner_attribuer_4" name="" sourceRef="task_examiner_projet_4" targetRef="task_attribuer_note_4">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_attribuer_join_1" name="" sourceRef="task_attribuer_note_1" targetRef="parallel_join_gateway">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_attribuer_join_2" name="" sourceRef="task_attribuer_note_2" targetRef="parallel_join_gateway">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_attribuer_join_3" name="" sourceRef="task_attribuer_note_3" targetRef="parallel_join_gateway">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_attribuer_join_4" name="" sourceRef="task_attribuer_note_4" targetRef="parallel_join_gateway">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_join_classer" name="" sourceRef="parallel_join_gateway" targetRef="task_classer_projet">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_classer_end" name="" sourceRef="task_classer_projet" targetRef="end_event">
    </bpmn:sequenceFlow>
  </bpmn:process>
