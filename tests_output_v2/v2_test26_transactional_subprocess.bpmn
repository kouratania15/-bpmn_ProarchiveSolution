<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_vente_immobiliere"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_signature_transfert" name="Acte signé" />
  <bpmn:message id="Message_flow_notif_reussi_transmission" name="Notification de succès" />
  <bpmn:message id="Message_flow_notif_echec_transmission" name="Notification d&#x27;échec" />
  <bpmn:collaboration id="Collaboration_process_vente_immobiliere">
    <bpmn:participant id="pool_notaire" name="Notaire" processRef="pool_notaire_process" />
    <bpmn:participant id="pool_acheteur" name="Acheteur" processRef="pool_acheteur_process" />
    <bpmn:messageFlow id="flow_signature_transfert" name="Acte signé" sourceRef="task_signature_acte" targetRef="task_transfert_fonds" messageRef="Message_flow_signature_transfert" />
    <bpmn:messageFlow id="flow_notif_reussi_transmission" name="Notification de succès" sourceRef="task_notifier_transfert_reussi" targetRef="task_transmission_decision_reussi" messageRef="Message_flow_notif_reussi_transmission" />
    <bpmn:messageFlow id="flow_notif_echec_transmission" name="Notification d&#x27;échec" sourceRef="task_notifier_transfert_echec" targetRef="task_transmission_decision_echec" messageRef="Message_flow_notif_echec_transmission" />
  </bpmn:collaboration>
  <bpmn:process id="pool_notaire_process" name="Notaire" isExecutable="true">
    <bpmn:startEvent id="start_event_vente" name="Début du processus de vente">
      <bpmn:outgoing>flow_start_signature</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_signature_acte" name="Signer l&#x27;acte notarié">
      <bpmn:incoming>flow_start_signature</bpmn:incoming>
      <bpmn:incoming>flow_annulation_signature</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="task_transmission_decision_reussi" name="Transmettre le résultat du transfert (succès)">
      <bpmn:outgoing>flow_transmission_reussi_finalisation</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_transmission_decision_echec" name="Transmettre le résultat du transfert (échec)">
      <bpmn:outgoing>flow_transmission_echec_annulation</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_annulation_etapes" name="Annuler les étapes précédentes">
      <bpmn:incoming>flow_transmission_echec_annulation</bpmn:incoming>
      <bpmn:outgoing>flow_annulation_signature</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_finalisation_vente" name="Finaliser la vente">
      <bpmn:incoming>flow_transmission_reussi_finalisation</bpmn:incoming>
      <bpmn:outgoing>flow_finalisation_fin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_event_vente_finalisee" name="Vente finalisée">
      <bpmn:incoming>flow_finalisation_fin</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_signature" name="" sourceRef="start_event_vente" targetRef="task_signature_acte">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_transmission_reussi_finalisation" name="" sourceRef="task_transmission_decision_reussi" targetRef="task_finalisation_vente">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_finalisation_fin" name="" sourceRef="task_finalisation_vente" targetRef="end_event_vente_finalisee">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_transmission_echec_annulation" name="" sourceRef="task_transmission_decision_echec" targetRef="task_annulation_etapes">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_annulation_signature" name="Annuler signature" sourceRef="task_annulation_etapes" targetRef="task_signature_acte">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_acheteur_process" name="Acheteur" isExecutable="true">
    <bpmn:task id="task_transfert_fonds" name="Transférer les fonds">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_acheteur&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_transfert_gateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_notifier_transfert_reussi" name="Notifier le résultat du transfert (succès)">
      <bpmn:incoming>flow_gateway_reussi_notif</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="task_notifier_transfert_echec" name="Notifier le résultat du transfert (échec)">
      <bpmn:incoming>flow_gateway_echec_notif</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_transfert" name="Résultat du transfert des fonds">
      <bpmn:incoming>flow_transfert_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_reussi_notif</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_echec_notif</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_transfert_gateway" name="" sourceRef="task_transfert_fonds" targetRef="gateway_transfert">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_reussi_notif" name="Transfert réussi" sourceRef="gateway_transfert" targetRef="task_notifier_transfert_reussi">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_echec_notif" name="Transfert échoué" sourceRef="gateway_transfert" targetRef="task_notifier_transfert_echec">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_vente_immobiliere">
      <bpmndi:BPMNShape id="pool_notaire_di" bpmnElement="pool_notaire" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="1376" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_acheteur_di" bpmnElement="pool_acheteur" isHorizontal="true">
        <dc:Bounds x="60" y="390" width="960" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_vente_di" bpmnElement="start_event_vente">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_signature_acte_di" bpmnElement="task_signature_acte">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_transfert_fonds_di" bpmnElement="task_transfert_fonds">
        <dc:Bounds x="440" y="430" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_transmission_decision_reussi_di" bpmnElement="task_transmission_decision_reussi">
        <dc:Bounds x="920" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_transmission_decision_echec_di" bpmnElement="task_transmission_decision_echec">
        <dc:Bounds x="920" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_annulation_etapes_di" bpmnElement="task_annulation_etapes">
        <dc:Bounds x="1080" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_finalisation_vente_di" bpmnElement="task_finalisation_vente">
        <dc:Bounds x="1080" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_notifier_transfert_reussi_di" bpmnElement="task_notifier_transfert_reussi">
        <dc:Bounds x="760" y="430" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_notifier_transfert_echec_di" bpmnElement="task_notifier_transfert_echec">
        <dc:Bounds x="760" y="540" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_vente_finalisee_di" bpmnElement="end_event_vente_finalisee">
        <dc:Bounds x="1240" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_transfert_di" bpmnElement="gateway_transfert">
        <dc:Bounds x="600" y="430" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_signature_di" bpmnElement="flow_start_signature">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_transfert_gateway_di" bpmnElement="flow_transfert_gateway">
        <di:waypoint x="540" y="470" />
        <di:waypoint x="570" y="470" />
        <di:waypoint x="570" y="455" />
        <di:waypoint x="600" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_reussi_notif_di" bpmnElement="flow_gateway_reussi_notif">
        <di:waypoint x="650" y="455" />
        <di:waypoint x="705" y="455" />
        <di:waypoint x="705" y="470" />
        <di:waypoint x="760" y="470" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="450" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_echec_notif_di" bpmnElement="flow_gateway_echec_notif">
        <di:waypoint x="650" y="455" />
        <di:waypoint x="705" y="455" />
        <di:waypoint x="705" y="580" />
        <di:waypoint x="760" y="580" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="560" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_transmission_reussi_finalisation_di" bpmnElement="flow_transmission_reussi_finalisation">
        <di:waypoint x="1020" y="130" />
        <di:waypoint x="1080" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_finalisation_fin_di" bpmnElement="flow_finalisation_fin">
        <di:waypoint x="1180" y="130" />
        <di:waypoint x="1210" y="130" />
        <di:waypoint x="1210" y="108" />
        <di:waypoint x="1240" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_transmission_echec_annulation_di" bpmnElement="flow_transmission_echec_annulation">
        <di:waypoint x="1020" y="240" />
        <di:waypoint x="1080" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_annulation_signature_di" bpmnElement="flow_annulation_signature">
        <di:waypoint x="1180" y="240" />
        <di:waypoint x="1210" y="240" />
        <di:waypoint x="1210" y="300" />
        <di:waypoint x="250" y="300" />
        <di:waypoint x="250" y="130" />
        <di:waypoint x="280" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="230" y="280" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_signature_transfert_di" bpmnElement="flow_signature_transfert">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="470" />
        <di:waypoint x="440" y="470" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="390" y="450" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notif_reussi_transmission_di" bpmnElement="flow_notif_reussi_transmission">
        <di:waypoint x="860" y="470" />
        <di:waypoint x="890" y="470" />
        <di:waypoint x="890" y="130" />
        <di:waypoint x="920" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="870" y="110" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notif_echec_transmission_di" bpmnElement="flow_notif_echec_transmission">
        <di:waypoint x="860" y="580" />
        <di:waypoint x="890" y="580" />
        <di:waypoint x="890" y="240" />
        <di:waypoint x="920" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="870" y="220" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>