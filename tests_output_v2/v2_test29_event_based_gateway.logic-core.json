{
  "process": {
    "id": "process_commercial_offer",
    "name": "Processus de suivi d'offre commerciale",
    "isExecutable": true
  },
  "pools": [
    {
      "id": "pool_entreprise",
      "name": "Entreprise",
      "lanes": [
        {
          "id": "lane_commercial",
          "name": "Commercial"
        },
        {
          "id": "lane_systeme",
          "name": "Système"
        }
      ]
    },
    {
      "id": "pool_prospect",
      "name": "Prospect"
    }
  ],
  "nodes": [
    {
      "id": "start_offer_sent",
      "type": "startEvent",
      "name": "Offre commerciale envoyée",
      "eventDefinition": "none",
      "sourceProcessElement": "activity_1",
      "poolId": "pool_entreprise",
      "documentation": "GAP: connexion automatique de secours — assigné automatiquement au pool 'pool_entreprise' (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier."
    },
    {
      "id": "task_send_offer",
      "type": "task",
      "name": "Envoyer une offre commerciale",
      "poolId": "pool_entreprise",
      "laneId": "lane_systeme",
      "sourceProcessElement": "activity_1"
    },
    {
      "id": "task_wait_response",
      "type": "receiveTask",
      "name": "Attendre une réponse ou expiration du délai",
      "poolId": "pool_entreprise",
      "laneId": "lane_systeme",
      "sourceProcessElement": "activity_4"
    },
    {
      "id": "event_response_received",
      "type": "intermediateCatchEvent",
      "name": "Réponse du prospect",
      "eventDefinition": "message",
      "eventDetail": "Réponse du prospect",
      "poolId": "pool_prospect",
      "sourceProcessElement": "event_1",
      "documentation": "GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool 'pool_prospect' ; cohérence métier non garantie, à vérifier."
    },
    {
      "id": "event_timeout_expired",
      "type": "intermediateCatchEvent",
      "name": "Expiration du délai de 10 jours",
      "eventDefinition": "timer",
      "eventDetail": "P10D",
      "poolId": "pool_entreprise",
      "sourceProcessElement": "event_2"
    },
    {
      "id": "task_process_response",
      "type": "task",
      "name": "Traiter la réponse du prospect",
      "poolId": "pool_entreprise",
      "laneId": "lane_commercial",
      "sourceProcessElement": "activity_2"
    },
    {
      "id": "task_auto_reminder",
      "type": "serviceTask",
      "name": "Relancer automatiquement le prospect",
      "poolId": "pool_entreprise",
      "laneId": "lane_systeme",
      "sourceProcessElement": "activity_3"
    },
    {
      "id": "end_process_completed",
      "type": "endEvent",
      "name": "Processus terminé",
      "eventDefinition": "none",
      "poolId": "pool_entreprise",
      "documentation": "GAP: connexion automatique de secours — assigné automatiquement au pool 'pool_entreprise' (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier."
    }
