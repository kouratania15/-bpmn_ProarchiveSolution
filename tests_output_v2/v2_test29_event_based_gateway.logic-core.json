      "sourceProcessElement": "relation_001"
    },
    {
      "id": "flow_wait_response_event",
      "source": "task_wait_response",
      "target": "event_response_received",
      "type": "messageFlow",
      "sourceProcessElement": "relation_004"
    },
    {
      "id": "flow_wait_timeout_event",
      "source": "task_wait_response",
      "target": "event_timeout_expired",
      "type": "sequenceFlow",
      "sourceProcessElement": "relation_005"
    },
    {
      "id": "flow_event_response_process",
