  "edges": [
    {
      "id": "flow_start_send_offer",
      "source": "start_offer_sent",
      "target": "task_send_offer",
      "type": "sequenceFlow",
      "sourceProcessElement": "relation_001"
    },
    {
      "id": "flow_send_offer_wait",
