<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_process_commande" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:collaboration id="Collaboration_process_commande">
    <bpmn:participant id="pool_company" name="Entreprise" processRef="process_commande" />
  </bpmn:collaboration>
  <bpmn:process id="process_commande" name="Entreprise" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_entrepot" name="Entrepôt">
        <bpmn:flowNodeRef>task_preparer_expedition</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_client" name="Client">
        <bpmn:flowNodeRef>start_commande</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_placer_commande</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>event_rupture_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>event_stock_disponible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_commande_expediee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_commande_attente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>event_stock_disponible_split_gw</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_commande" name="Commande reçue">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool 'pool_company' (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_placer_commande</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_placer_commande" name="Placer une commande">
      <bpmn:incoming>flow_start_placer_commande</bpmn:incoming>
      <bpmn:outgoing>flow_placer_commande_rupture_stock</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="event_rupture_stock" name="Commande en rupture de stock">
      <bpmn:incoming>flow_placer_commande_rupture_stock</bpmn:incoming>
      <bpmn:outgoing>flow_rupture_stock_attente</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="event_rupture_stock_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="event_stock_disponible" name="Stock disponible">
      <bpmn:documentation>GAP: connexion automatique de secours — un exclusiveGateway ('event_stock_disponible_split_gw') a été inséré automatiquement après ce nœud car il portait plusieurs sequenceFlow sortants sans passerelle — vérifier qu'il ne s'agit pas d'une fusion erronée de deux mentions textuelles distinctes plutôt que d'une vraie décision. ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_rupture_stock_attente</bpmn:incoming>
      <bpmn:outgoing>flow_event_stock_disponible_to_event_stock_disponible_split_gw</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="event_stock_disponible_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end_commande_expediee" name="Commande expédiée">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool 'pool_company' (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_commande_attente" name="Commande en attente de stock">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool 'pool_company' (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_stock_disponible_attente_fin</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="event_stock_disponible_split_gw" name="">
      <bpmn:incoming>flow_event_stock_disponible_to_event_stock_disponible_split_gw</bpmn:incoming>
      <bpmn:outgoing>flow_stock_disponible_attente_fin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="task_preparer_expedition" name="Préparer l&#39;expédition de la commande" />
    <bpmn:sequenceFlow id="flow_start_placer_commande" name="" sourceRef="start_commande" targetRef="task_placer_commande" />
    <bpmn:sequenceFlow id="flow_placer_commande_rupture_stock" name="Rupture de stock détectée" sourceRef="task_placer_commande" targetRef="event_rupture_stock" />
    <bpmn:sequenceFlow id="flow_rupture_stock_attente" name="Attente de disponibilité du stock" sourceRef="event_rupture_stock" targetRef="event_stock_disponible" />
    <bpmn:sequenceFlow id="flow_event_stock_disponible_to_event_stock_disponible_split_gw" name="" sourceRef="event_stock_disponible" targetRef="event_stock_disponible_split_gw" />
    <bpmn:sequenceFlow id="flow_stock_disponible_attente_fin" name="Stock toujours indisponible, commande en attente" sourceRef="event_stock_disponible_split_gw" targetRef="end_commande_attente" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_commande">
      <bpmndi:BPMNShape id="pool_company_di" bpmnElement="pool_company" isHorizontal="true">
        <dc:Bounds x="160" y="50" width="1140" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_entrepot_di" bpmnElement="lane_entrepot" isHorizontal="true">
        <dc:Bounds x="190" y="240" width="1110" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_client_di" bpmnElement="lane_client" isHorizontal="true">
        <dc:Bounds x="190" y="50" width="1110" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_commande_di" bpmnElement="start_commande">
        <dc:Bounds x="220" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="194" y="116" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_placer_commande_di" bpmnElement="task_placer_commande">
        <dc:Bounds x="380" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_rupture_stock_di" bpmnElement="event_rupture_stock">
        <dc:Bounds x="540" y="90" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="519" y="126" width="79" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_stock_disponible_di" bpmnElement="event_stock_disponible">
        <dc:Bounds x="700" y="90" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="678" y="126" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_commande_expediee_di" bpmnElement="end_commande_expediee">
        <dc:Bounds x="1180" y="80" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1170" y="116" width="57" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_commande_attente_di" bpmnElement="end_commande_attente">
        <dc:Bounds x="1020" y="210" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="999" y="246" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_stock_disponible_split_gw_di" bpmnElement="event_stock_disponible_split_gw" isMarkerVisible="true">
        <dc:Bounds x="860" y="90" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_preparer_expedition_di" bpmnElement="task_preparer_expedition">
        <dc:Bounds x="1060" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_placer_commande_di" bpmnElement="flow_start_placer_commande">
        <di:waypoint x="256" y="98" />
        <di:waypoint x="318" y="98" />
        <di:waypoint x="318" y="130" />
        <di:waypoint x="380" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_placer_commande_rupture_stock_di" bpmnElement="flow_placer_commande_rupture_stock">
        <di:waypoint x="480" y="130" />
        <di:waypoint x="510" y="130" />
        <di:waypoint x="510" y="108" />
        <di:waypoint x="540" y="108" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="478" y="88" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rupture_stock_attente_di" bpmnElement="flow_rupture_stock_attente">
        <di:waypoint x="576" y="108" />
        <di:waypoint x="700" y="108" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="674" y="88" width="73" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_stock_disponible_attente_fin_di" bpmnElement="flow_stock_disponible_attente_fin">
        <di:waypoint x="910" y="115" />
        <di:waypoint x="965" y="115" />
        <di:waypoint x="965" y="228" />
        <di:waypoint x="1020" y="228" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="940" y="208" width="70" height="53" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_event_stock_disponible_to_event_stock_disponible_split_gw_di" bpmnElement="flow_event_stock_disponible_to_event_stock_disponible_split_gw">
        <di:waypoint x="736" y="108" />
        <di:waypoint x="798" y="108" />
        <di:waypoint x="798" y="115" />
        <di:waypoint x="860" y="115" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
