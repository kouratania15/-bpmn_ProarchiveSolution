<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_commercial_offer"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_wait_response_event" name="flow_wait_response_event" />
  <bpmn:message id="Message_flow_event_response_process" name="flow_event_response_process" />
  <bpmn:collaboration id="Collaboration_process_commercial_offer">
    <bpmn:participant id="pool_entreprise" name="Entreprise" processRef="pool_entreprise_process" />
    <bpmn:participant id="pool_prospect" name="Prospect" processRef="pool_prospect_process" />
    <bpmn:messageFlow id="flow_wait_response_event" name="" sourceRef="task_wait_response" targetRef="event_response_received" messageRef="Message_flow_wait_response_event" />
    <bpmn:messageFlow id="flow_event_response_process" name="" sourceRef="event_response_received" targetRef="task_process_response" messageRef="Message_flow_event_response_process" />
  </bpmn:collaboration>
  <bpmn:process id="pool_entreprise_process" name="Entreprise" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_commercial" name="Commercial">
        <bpmn:flowNodeRef>task_process_response</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_systeme" name="Système">
        <bpmn:flowNodeRef>task_send_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_wait_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_auto_reminder</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_offer_sent" name="Offre commerciale envoyée">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_entreprise&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_send_offer</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_send_offer" name="Envoyer une offre commerciale">
      <bpmn:incoming>flow_start_send_offer</bpmn:incoming>
      <bpmn:outgoing>flow_send_offer_wait</bpmn:outgoing>
    </bpmn:task>
    <bpmn:receiveTask id="task_wait_response" name="Attendre une réponse ou expiration du délai">
      <bpmn:incoming>flow_send_offer_wait</bpmn:incoming>
      <bpmn:outgoing>flow_wait_timeout_event</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:intermediateCatchEvent id="event_timeout_expired" name="Expiration du délai de 10 jours">
      <bpmn:incoming>flow_wait_timeout_event</bpmn:incoming>
      <bpmn:outgoing>flow_event_timeout_reminder</bpmn:outgoing>
      <bpmn:timerEventDefinition id="event_timeout_expired_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_process_response" name="Traiter la réponse du prospect">
      <bpmn:outgoing>flow_process_response_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="task_auto_reminder" name="Relancer automatiquement le prospect">
      <bpmn:incoming>flow_event_timeout_reminder</bpmn:incoming>
      <bpmn:outgoing>flow_auto_reminder_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_process_completed" name="Processus terminé">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_entreprise&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_process_response_end</bpmn:incoming>
      <bpmn:incoming>flow_auto_reminder_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_send_offer" name="" sourceRef="start_offer_sent" targetRef="task_send_offer">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_send_offer_wait" name="" sourceRef="task_send_offer" targetRef="task_wait_response">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_wait_timeout_event" name="" sourceRef="task_wait_response" targetRef="event_timeout_expired">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_event_timeout_reminder" name="" sourceRef="event_timeout_expired" targetRef="task_auto_reminder">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_process_response_end" name="" sourceRef="task_process_response" targetRef="end_process_completed">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_auto_reminder_end" name="" sourceRef="task_auto_reminder" targetRef="end_process_completed">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_prospect_process" name="Prospect" isExecutable="true">
    <bpmn:intermediateCatchEvent id="event_response_received" name="Réponse du prospect">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_prospect&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:messageEventDefinition id="event_response_received_def">
      </bpmn:messageEventDefinition>
    </bpmn:intermediateCatchEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_commercial_offer">
      <bpmndi:BPMNShape id="pool_entreprise_di" bpmnElement="pool_entreprise" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="980" height="490" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_prospect_di" bpmnElement="pool_prospect" isHorizontal="true">
        <dc:Bounds x="60" y="580" width="736" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_commercial_di" bpmnElement="lane_commercial" isHorizontal="true">
        <dc:Bounds x="90" y="50" width="950" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_systeme_di" bpmnElement="lane_systeme" isHorizontal="true">
        <dc:Bounds x="90" y="240" width="950" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_offer_sent_di" bpmnElement="start_offer_sent">
        <dc:Bounds x="120" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_offer_di" bpmnElement="task_send_offer">
        <dc:Bounds x="280" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_wait_response_di" bpmnElement="task_wait_response">
        <dc:Bounds x="440" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_response_received_di" bpmnElement="event_response_received">
        <dc:Bounds x="600" y="620" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_timeout_expired_di" bpmnElement="event_timeout_expired">
        <dc:Bounds x="600" y="166" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_process_response_di" bpmnElement="task_process_response">
        <dc:Bounds x="760" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_auto_reminder_di" bpmnElement="task_auto_reminder">
        <dc:Bounds x="760" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_process_completed_di" bpmnElement="end_process_completed">
        <dc:Bounds x="920" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_send_offer_di" bpmnElement="flow_start_send_offer">
        <di:waypoint x="156" y="98" />
        <di:waypoint x="218" y="98" />
        <di:waypoint x="218" y="320" />
        <di:waypoint x="280" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_send_offer_wait_di" bpmnElement="flow_send_offer_wait">
        <di:waypoint x="380" y="320" />
        <di:waypoint x="440" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_wait_timeout_event_di" bpmnElement="flow_wait_timeout_event">
        <di:waypoint x="540" y="320" />
        <di:waypoint x="570" y="320" />
        <di:waypoint x="570" y="184" />
        <di:waypoint x="600" y="184" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_event_timeout_reminder_di" bpmnElement="flow_event_timeout_reminder">
        <di:waypoint x="636" y="184" />
        <di:waypoint x="698" y="184" />
        <di:waypoint x="698" y="430" />
        <di:waypoint x="760" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_process_response_end_di" bpmnElement="flow_process_response_end">
        <di:waypoint x="860" y="130" />
        <di:waypoint x="890" y="130" />
        <di:waypoint x="890" y="98" />
        <di:waypoint x="920" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_auto_reminder_end_di" bpmnElement="flow_auto_reminder_end">
        <di:waypoint x="860" y="430" />
        <di:waypoint x="890" y="430" />
        <di:waypoint x="890" y="98" />
        <di:waypoint x="920" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_wait_response_event_di" bpmnElement="flow_wait_response_event">
        <di:waypoint x="540" y="320" />
        <di:waypoint x="570" y="320" />
        <di:waypoint x="570" y="638" />
        <di:waypoint x="600" y="638" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_event_response_process_di" bpmnElement="flow_event_response_process">
        <di:waypoint x="636" y="638" />
        <di:waypoint x="698" y="638" />
        <di:waypoint x="698" y="130" />
        <di:waypoint x="760" y="130" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>