<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_credit_card_application"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_process_credit_card_application">
    <bpmn:participant id="bank_pool" name="Banque" processRef="process_credit_card_application" />
  </bpmn:collaboration>
  <bpmn:process id="process_credit_card_application" name="Banque" isExecutable="true">
    <bpmn:startEvent id="start_event" name="Demande de carte de crédit reçue">
      <bpmn:outgoing>flow_start_to_study</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_study_request" name="Étudier la demande de carte de crédit">
      <bpmn:incoming>flow_start_to_study</bpmn:incoming>
      <bpmn:outgoing>flow_study_to_check_income</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_check_income" name="Vérifier si le revenu est suffisant">
      <bpmn:incoming>flow_study_to_check_income</bpmn:incoming>
      <bpmn:outgoing>flow_check_income_to_gateway_income</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_check_credit_history" name="Vérifier si l&#x27;historique de crédit est bon">
      <bpmn:incoming>flow_check_income_split_gw_to_check_history</bpmn:incoming>
      <bpmn:outgoing>flow_check_history_to_gateway_decision</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="task_check_income_split_gw" name="Revenu suffisant ?">
      <bpmn:incoming>flow_check_income_to_gateway_income</bpmn:incoming>
      <bpmn:outgoing>flow_check_income_split_gw_to_check_history</bpmn:outgoing>
      <bpmn:outgoing>flow_check_income_split_gw_to_gateway_decision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:inclusiveGateway id="gateway_decision" name="Conditions remplies ?">
      <bpmn:incoming>flow_check_income_split_gw_to_gateway_decision</bpmn:incoming>
      <bpmn:incoming>flow_check_history_to_gateway_decision</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_to_approve_high</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_to_approve_low</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_to_reject</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="task_approve_high_limit" name="Approuver la carte avec un plafond élevé">
      <bpmn:incoming>flow_gateway_to_approve_high</bpmn:incoming>
      <bpmn:outgoing>flow_approve_high_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_approve_low_limit" name="Approuver la carte avec un plafond réduit">
      <bpmn:incoming>flow_gateway_to_approve_low</bpmn:incoming>
      <bpmn:outgoing>flow_approve_low_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_reject_request" name="Rejeter la demande de carte de crédit">
      <bpmn:incoming>flow_gateway_to_reject</bpmn:incoming>
      <bpmn:outgoing>flow_reject_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_event_approve_high" name="Carte approuvée avec plafond élevé">
      <bpmn:incoming>flow_approve_high_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_event_approve_low" name="Carte approuvée avec plafond réduit">
      <bpmn:incoming>flow_approve_low_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_event_rejected" name="Demande rejetée">
      <bpmn:incoming>flow_reject_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_to_study" name="" sourceRef="start_event" targetRef="task_study_request">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_study_to_check_income" name="" sourceRef="task_study_request" targetRef="task_check_income">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_check_income_to_gateway_income" name="" sourceRef="task_check_income" targetRef="task_check_income_split_gw">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_check_income_split_gw_to_check_history" name="Revenu insuffisant" sourceRef="task_check_income_split_gw" targetRef="task_check_credit_history">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_check_income_split_gw_to_gateway_decision" name="Revenu suffisant" sourceRef="task_check_income_split_gw" targetRef="gateway_decision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_check_history_to_gateway_decision" name="" sourceRef="task_check_credit_history" targetRef="gateway_decision">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_to_approve_high" name="Les deux conditions remplies" sourceRef="gateway_decision" targetRef="task_approve_high_limit">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_to_approve_low" name="Une seule condition remplie" sourceRef="gateway_decision" targetRef="task_approve_low_limit">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_to_reject" name="Aucune condition remplie" sourceRef="gateway_decision" targetRef="task_reject_request">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_approve_high_to_end" name="" sourceRef="task_approve_high_limit" targetRef="end_event_approve_high">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_approve_low_to_end" name="" sourceRef="task_approve_low_limit" targetRef="end_event_approve_low">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_reject_to_end" name="" sourceRef="task_reject_request" targetRef="end_event_rejected">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_credit_card_application">
      <bpmndi:BPMNShape id="bank_pool_di" bpmnElement="bank_pool" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="1216" height="542" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_di" bpmnElement="start_event">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_study_request_di" bpmnElement="task_study_request">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_income_di" bpmnElement="task_check_income">
        <dc:Bounds x="440" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_credit_history_di" bpmnElement="task_check_credit_history">
        <dc:Bounds x="760" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_income_split_gw_di" bpmnElement="task_check_income_split_gw">
        <dc:Bounds x="600" y="90" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_decision_di" bpmnElement="gateway_decision">
        <dc:Bounds x="760" y="266" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_approve_high_limit_di" bpmnElement="task_approve_high_limit">
        <dc:Bounds x="920" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_approve_low_limit_di" bpmnElement="task_approve_low_limit">
        <dc:Bounds x="920" y="266" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_reject_request_di" bpmnElement="task_reject_request">
        <dc:Bounds x="920" y="442" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_approve_high_di" bpmnElement="end_event_approve_high">
        <dc:Bounds x="1080" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_approve_low_di" bpmnElement="end_event_approve_low">
        <dc:Bounds x="1080" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_rejected_di" bpmnElement="end_event_rejected">
        <dc:Bounds x="1080" y="376" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_study_di" bpmnElement="flow_start_to_study">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_study_to_check_income_di" bpmnElement="flow_study_to_check_income">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="440" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_income_to_gateway_income_di" bpmnElement="flow_check_income_to_gateway_income">
        <di:waypoint x="540" y="130" />
        <di:waypoint x="570" y="130" />
        <di:waypoint x="570" y="115" />
        <di:waypoint x="600" y="115" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_income_split_gw_to_check_history_di" bpmnElement="flow_check_income_split_gw_to_check_history">
        <di:waypoint x="650" y="115" />
        <di:waypoint x="705" y="115" />
        <di:waypoint x="705" y="130" />
        <di:waypoint x="760" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="110" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_income_split_gw_to_gateway_decision_di" bpmnElement="flow_check_income_split_gw_to_gateway_decision">
        <di:waypoint x="650" y="115" />
        <di:waypoint x="705" y="115" />
        <di:waypoint x="705" y="291" />
        <di:waypoint x="760" y="291" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="271" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_history_to_gateway_decision_di" bpmnElement="flow_check_history_to_gateway_decision">
        <di:waypoint x="860" y="130" />
        <di:waypoint x="890" y="130" />
        <di:waypoint x="890" y="351" />
        <di:waypoint x="730" y="351" />
        <di:waypoint x="730" y="291" />
        <di:waypoint x="760" y="291" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_to_approve_high_di" bpmnElement="flow_gateway_to_approve_high">
        <di:waypoint x="810" y="291" />
        <di:waypoint x="865" y="291" />
        <di:waypoint x="865" y="130" />
        <di:waypoint x="920" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="845" y="110" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_to_approve_low_di" bpmnElement="flow_gateway_to_approve_low">
        <di:waypoint x="810" y="291" />
        <di:waypoint x="865" y="291" />
        <di:waypoint x="865" y="306" />
        <di:waypoint x="920" y="306" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="845" y="286" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_to_reject_di" bpmnElement="flow_gateway_to_reject">
        <di:waypoint x="810" y="291" />
        <di:waypoint x="865" y="291" />
        <di:waypoint x="865" y="482" />
        <di:waypoint x="920" y="482" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="845" y="462" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approve_high_to_end_di" bpmnElement="flow_approve_high_to_end">
        <di:waypoint x="1020" y="130" />
        <di:waypoint x="1050" y="130" />
        <di:waypoint x="1050" y="108" />
        <di:waypoint x="1080" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approve_low_to_end_di" bpmnElement="flow_approve_low_to_end">
        <di:waypoint x="1020" y="306" />
        <di:waypoint x="1050" y="306" />
        <di:waypoint x="1050" y="218" />
        <di:waypoint x="1080" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reject_to_end_di" bpmnElement="flow_reject_to_end">
        <di:waypoint x="1020" y="482" />
        <di:waypoint x="1050" y="482" />
        <di:waypoint x="1050" y="394" />
        <di:waypoint x="1080" y="394" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>