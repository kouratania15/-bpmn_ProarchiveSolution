<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_order_preparation"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_visitor_order_to_check_ingredients" name="flow_visitor_order_to_check_ingredients" />
  <bpmn:collaboration id="Collaboration_process_order_preparation">
    <bpmn:participant id="pool_visitor" name="Visiteur" processRef="pool_visitor_process" />
    <bpmn:participant id="pool_restaurant" name="Restaurant" processRef="pool_restaurant_process" />
    <bpmn:messageFlow id="flow_visitor_order_to_check_ingredients" name="" sourceRef="task_visitor_orders_dish" targetRef="task_restaurant_checks_ingredients" messageRef="Message_flow_visitor_order_to_check_ingredients" />
  </bpmn:collaboration>
  <bpmn:process id="pool_visitor_process" name="Visiteur" isExecutable="true">
    <bpmn:startEvent id="start_event_received_order" name="Commande reçue">
      <bpmn:outgoing>flow_start_to_visitor_order</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_visitor_orders_dish" name="Commander un plat en ligne">
      <bpmn:incoming>flow_start_to_visitor_order</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_start_to_visitor_order" name="" sourceRef="start_event_received_order" targetRef="task_visitor_orders_dish">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_restaurant_process" name="Restaurant" isExecutable="true">
    <bpmn:task id="task_restaurant_checks_ingredients" name="Vérifier la disponibilité des ingrédients">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_restaurant&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_check_ingredients_to_gateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_ingredients_available" name="Tous les ingrédients disponibles ?">
      <bpmn:incoming>flow_check_ingredients_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_ingredients_no_to_cancel_order</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_ingredients_yes_to_check_payment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="task_restaurant_cancel_order_missing_ingredients" name="Annuler la commande (ingrédient manquant)">
      <bpmn:incoming>flow_gateway_ingredients_no_to_cancel_order</bpmn:incoming>
      <bpmn:outgoing>flow_cancel_missing_ingredients_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_restaurant_check_payment_method" name="Vérifier le mode de paiement">
      <bpmn:incoming>flow_gateway_ingredients_yes_to_check_payment</bpmn:incoming>
      <bpmn:outgoing>flow_check_payment_to_gateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_payment_accepted" name="Paiement accepté ?">
      <bpmn:incoming>flow_check_payment_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_payment_yes_to_prepare_dish</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_payment_no_to_cancel_order</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="task_restaurant_prepare_dish" name="Préparer le plat">
      <bpmn:incoming>flow_gateway_payment_yes_to_prepare_dish</bpmn:incoming>
      <bpmn:outgoing>flow_prepare_dish_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_restaurant_cancel_order_payment_refused" name="Annuler la commande (paiement refusé)">
      <bpmn:incoming>flow_gateway_payment_no_to_cancel_order</bpmn:incoming>
      <bpmn:outgoing>flow_cancel_payment_refused_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_event_order_finalized" name="Commande finalisée (préparation réussie)">
      <bpmn:incoming>flow_prepare_dish_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_event_order_cancelled_missing_ingredients" name="Commande annulée (ingrédient manquant)">
      <bpmn:incoming>flow_cancel_missing_ingredients_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_event_order_cancelled_payment_refused" name="Commande annulée (paiement refusé)">
      <bpmn:incoming>flow_cancel_payment_refused_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_check_ingredients_to_gateway" name="" sourceRef="task_restaurant_checks_ingredients" targetRef="gateway_ingredients_available">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_ingredients_no_to_cancel_order" name="Non" sourceRef="gateway_ingredients_available" targetRef="task_restaurant_cancel_order_missing_ingredients">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_cancel_missing_ingredients_to_end" name="" sourceRef="task_restaurant_cancel_order_missing_ingredients" targetRef="end_event_order_cancelled_missing_ingredients">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_ingredients_yes_to_check_payment" name="Oui" sourceRef="gateway_ingredients_available" targetRef="task_restaurant_check_payment_method">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_check_payment_to_gateway" name="" sourceRef="task_restaurant_check_payment_method" targetRef="gateway_payment_accepted">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_payment_yes_to_prepare_dish" name="Oui" sourceRef="gateway_payment_accepted" targetRef="task_restaurant_prepare_dish">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_prepare_dish_to_end" name="" sourceRef="task_restaurant_prepare_dish" targetRef="end_event_order_finalized">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_payment_no_to_cancel_order" name="Non" sourceRef="gateway_payment_accepted" targetRef="task_restaurant_cancel_order_payment_refused">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_cancel_payment_refused_to_end" name="" sourceRef="task_restaurant_cancel_order_payment_refused" targetRef="end_event_order_cancelled_payment_refused">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_order_preparation">
      <bpmndi:BPMNShape id="pool_visitor_di" bpmnElement="pool_visitor" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="480" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_restaurant_di" bpmnElement="pool_restaurant" isHorizontal="true">
        <dc:Bounds x="60" y="280" width="1376" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_received_order_di" bpmnElement="start_event_received_order">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_visitor_orders_dish_di" bpmnElement="task_visitor_orders_dish">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_restaurant_checks_ingredients_di" bpmnElement="task_restaurant_checks_ingredients">
        <dc:Bounds x="440" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_ingredients_available_di" bpmnElement="gateway_ingredients_available">
        <dc:Bounds x="600" y="320" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_restaurant_cancel_order_missing_ingredients_di" bpmnElement="task_restaurant_cancel_order_missing_ingredients">
        <dc:Bounds x="760" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_restaurant_check_payment_method_di" bpmnElement="task_restaurant_check_payment_method">
        <dc:Bounds x="760" y="510" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_payment_accepted_di" bpmnElement="gateway_payment_accepted">
        <dc:Bounds x="920" y="430" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_restaurant_prepare_dish_di" bpmnElement="task_restaurant_prepare_dish">
        <dc:Bounds x="1080" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_restaurant_cancel_order_payment_refused_di" bpmnElement="task_restaurant_cancel_order_payment_refused">
        <dc:Bounds x="1080" y="510" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_order_finalized_di" bpmnElement="end_event_order_finalized">
        <dc:Bounds x="1240" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_order_cancelled_missing_ingredients_di" bpmnElement="end_event_order_cancelled_missing_ingredients">
        <dc:Bounds x="920" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_order_cancelled_payment_refused_di" bpmnElement="end_event_order_cancelled_payment_refused">
        <dc:Bounds x="1240" y="430" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_visitor_order_di" bpmnElement="flow_start_to_visitor_order">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_ingredients_to_gateway_di" bpmnElement="flow_check_ingredients_to_gateway">
        <di:waypoint x="540" y="360" />
        <di:waypoint x="570" y="360" />
        <di:waypoint x="570" y="345" />
        <di:waypoint x="600" y="345" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_ingredients_no_to_cancel_order_di" bpmnElement="flow_gateway_ingredients_no_to_cancel_order">
        <di:waypoint x="650" y="345" />
        <di:waypoint x="705" y="345" />
        <di:waypoint x="705" y="360" />
        <di:waypoint x="760" y="360" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="340" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_cancel_missing_ingredients_to_end_di" bpmnElement="flow_cancel_missing_ingredients_to_end">
        <di:waypoint x="860" y="360" />
        <di:waypoint x="890" y="360" />
        <di:waypoint x="890" y="338" />
        <di:waypoint x="920" y="338" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_ingredients_yes_to_check_payment_di" bpmnElement="flow_gateway_ingredients_yes_to_check_payment">
        <di:waypoint x="650" y="345" />
        <di:waypoint x="705" y="345" />
        <di:waypoint x="705" y="550" />
        <di:waypoint x="760" y="550" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="530" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_payment_to_gateway_di" bpmnElement="flow_check_payment_to_gateway">
        <di:waypoint x="860" y="550" />
        <di:waypoint x="890" y="550" />
        <di:waypoint x="890" y="455" />
        <di:waypoint x="920" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_payment_yes_to_prepare_dish_di" bpmnElement="flow_gateway_payment_yes_to_prepare_dish">
        <di:waypoint x="970" y="455" />
        <di:waypoint x="1025" y="455" />
        <di:waypoint x="1025" y="360" />
        <di:waypoint x="1080" y="360" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1005" y="340" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_prepare_dish_to_end_di" bpmnElement="flow_prepare_dish_to_end">
        <di:waypoint x="1180" y="360" />
        <di:waypoint x="1210" y="360" />
        <di:waypoint x="1210" y="338" />
        <di:waypoint x="1240" y="338" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_payment_no_to_cancel_order_di" bpmnElement="flow_gateway_payment_no_to_cancel_order">
        <di:waypoint x="970" y="455" />
        <di:waypoint x="1025" y="455" />
        <di:waypoint x="1025" y="550" />
        <di:waypoint x="1080" y="550" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1005" y="530" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_cancel_payment_refused_to_end_di" bpmnElement="flow_cancel_payment_refused_to_end">
        <di:waypoint x="1180" y="550" />
        <di:waypoint x="1210" y="550" />
        <di:waypoint x="1210" y="448" />
        <di:waypoint x="1240" y="448" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_visitor_order_to_check_ingredients_di" bpmnElement="flow_visitor_order_to_check_ingredients">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="360" />
        <di:waypoint x="440" y="360" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>