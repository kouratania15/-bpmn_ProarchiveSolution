      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_verifier_souscription_di" bpmnElement="task_verifier_souscription">
        <dc:Bounds x="600" y="520" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_annuler_reservation_di" bpmnElement="task_annuler_reservation">
        <dc:Bounds x="1080" y="816" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_confirmer_reservation_di" bpmnElement="task_confirmer_reservation">
