      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_reservation_annulee_di" bpmnElement="end_reservation_annulee">
        <dc:Bounds x="1240" y="750" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="boundary_event_compensation_di" bpmnElement="boundary_event_compensation">
        <dc:Bounds x="682" y="582" width="36" height="36" />
