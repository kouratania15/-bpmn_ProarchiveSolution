      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_compensation_service_di" bpmnElement="pool_compensation_service" isHorizontal="true">
        <dc:Bounds x="60" y="710" width="1376" height="256" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_reservation_di" bpmnElement="start_reservation">
