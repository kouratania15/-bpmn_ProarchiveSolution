{
  "process": {
    "id": "process_checkin_baggage",
    "name": "Processus d'enregistrement des bagages et d'embarquement",
    "documentation": "Processus d'enregistrement des bagages, impression de la carte d'embarquement et étiquetage des valises à l'aéroport.",
    "isExecutable": true
  },
  "pools": [
    {
      "id": "pool_aeroport",
      "name": "Aéroport",
      "lanes": [
        {
          "id": "lane_passager",
          "name": "Passager"
        },
        {
          "id": "lane_agent",
          "name": "Agent"
        },
        {
          "id": "lane_service_bagages",
          "name": "Service Bagages"
        }
      ]
    }
  ],
  "nodes": [
    {
      "id": "start_checkin",
      "type": "startEvent",
      "name": "Début du processus : Arrivée du passager",
      "eventDefinition": "none",
      "sourceProcessElement": "event_1",
      "poolId": "pool_aeroport"
    },
    {
      "id": "task_register_baggage",
      "type": "task",
      "name": "Enregistrer ses bagages",
      "poolId": "pool_aeroport",
      "laneId": "lane_passager",
      "sourceProcessElement": "activity_1"
    },
    {
      "id": "task_print_boarding_pass",
      "type": "task",
      "name": "Imprimer la carte d'embarquement",
      "poolId": "pool_aeroport",
      "laneId": "lane_agent",
      "sourceProcessElement": "activity_2"
    },
    {
      "id": "task_label_baggage",
      "type": "task",
      "name": "Étiqueter la valise",
      "poolId": "pool_aeroport",
      "laneId": "lane_service_bagages",
      "sourceProcessElement": "activity_3"
    },
    {
      "id": "parallel_gateway_checkin",
      "type": "parallelGateway",
      "name": "Activités parallèles : Impression et étiquetage",
      "gatewayDirection": "diverging",
      "sourceProcessElement": "gateway_parallel",
      "poolId": "pool_aeroport"
    },
    {
      "id": "parallel_gateway_join_checkin",
      "type": "parallelGateway",
      "name": "Convergence des activités parallèles",
      "gatewayDirection": "converging",
      "sourceProcessElement": "gateway_join",
      "poolId": "pool_aeroport"
    },
    {
      "id": "task_orient_passenger",
      "type": "task",
      "name": "Orienté le passager vers la porte d'embarquement",
      "poolId": "pool_aeroport",
      "laneId": "lane_agent",
      "sourceProcessElement": "activity_4"
    },
    {
      "id": "end_checkin_completed",
      "type": "endEvent",
      "name": "Fin des opérations d'enregistrement et d'étiquetage",
      "eventDefinition": "none",
      "sourceProcessElement": "event_2",
      "poolId": "pool_aeroport"
    }
  ],
  "edges": [
    {
      "id": "flow_start_register",
      "source": "start_checkin",
      "target": "task_register_baggage",
      "type": "sequenceFlow",
      "sourceProcessElement": "relation_001"
    },
    {
      "id": "flow_register_parallel",
      "source": "task_register_baggage",
      "target": "parallel_gateway_checkin",
      "type": "sequenceFlow",
      "sourceProcessElement": "relation_002, relation_003"
    },
    {
      "id": "flow_print_boarding_pass",
      "source": "parallel_gateway_checkin",
      "target": "task_print_boarding_pass",
      "type": "sequenceFlow",
      "sourceProcessElement": "relation_002"
    },
    {
      "id": "flow_label_baggage",
      "source": "parallel_gateway_checkin",
      "target": "task_label_baggage",
      "type": "sequenceFlow",
      "sourceProcessElement": "relation_003"
    },
    {
      "id": "flow_print_to_join",
      "source": "task_print_boarding_pass",
      "target": "parallel_gateway_join_checkin",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_label_to_join",
      "source": "task_label_baggage",
      "target": "parallel_gateway_join_checkin",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_join_to_orient",
      "source": "parallel_gateway_join_checkin",
      "target": "task_orient_passenger",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_orient_end",
      "source": "task_orient_passenger",
      "target": "end_checkin_completed",
      "type": "sequenceFlow"
    }
  ]
}