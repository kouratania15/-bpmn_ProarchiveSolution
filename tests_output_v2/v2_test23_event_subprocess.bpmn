<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_reservation_cancellation"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_notify_to_cancel_event" name="flow_notify_to_cancel_event" />
  <bpmn:message id="Message_flow_cancel_to_subprocess" name="flow_cancel_to_subprocess" />
  <bpmn:collaboration id="Collaboration_process_reservation_cancellation">
    <bpmn:participant id="pool_hotel" name="Hôtel" processRef="pool_hotel_process" />
    <bpmn:participant id="pool_client" name="Client" processRef="pool_client_process" />
    <bpmn:messageFlow id="flow_notify_to_cancel_event" name="" sourceRef="task_notify_cancellation" targetRef="intermediate_cancel_event" messageRef="Message_flow_notify_to_cancel_event" />
    <bpmn:messageFlow id="flow_cancel_to_subprocess" name="" sourceRef="intermediate_cancel_event" targetRef="subprocess_cancellation" messageRef="Message_flow_cancel_to_subprocess" />
  </bpmn:collaboration>
  <bpmn:process id="pool_hotel_process" name="Hôtel" isExecutable="true">
    <bpmn:startEvent id="start_reservation" name="Début du traitement de la réservation">
      <bpmn:outgoing>flow_start_to_process</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_process_reservation" name="Traiter une réservation de chambre">
      <bpmn:incoming>flow_start_to_process</bpmn:incoming>
      <bpmn:outgoing>flow_process_to_gateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="subprocess_cancellation" name="Annuler une réservation" triggeredByEvent="true">
      <bpmn:outgoing>flow_cancel_subprocess_to_main</bpmn:outgoing>
      <bpmn:startEvent id="start_cancellation_subprocess" name="Début du sous-processus d&#x27;annulation">
        <bpmn:outgoing>flow_start_cancel_to_refund</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="task_refund_client" name="Rembourser le client">
        <bpmn:incoming>flow_start_cancel_to_refund</bpmn:incoming>
        <bpmn:outgoing>flow_refund_to_release</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="task_release_room" name="Libérer la chambre">
        <bpmn:incoming>flow_refund_to_release</bpmn:incoming>
        <bpmn:outgoing>flow_release_to_end_cancel</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="end_cancellation_subprocess" name="Fin du sous-processus d&#x27;annulation">
        <bpmn:incoming>flow_release_to_end_cancel</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_start_cancel_to_refund" name="" sourceRef="start_cancellation_subprocess" targetRef="task_refund_client">
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="flow_refund_to_release" name="" sourceRef="task_refund_client" targetRef="task_release_room">
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="flow_release_to_end_cancel" name="" sourceRef="task_release_room" targetRef="end_cancellation_subprocess">
      </bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:endEvent id="end_reservation_processed" name="Réservation traitée avec succès">
      <bpmn:incoming>flow_cancel_subprocess_to_main</bpmn:incoming>
      <bpmn:incoming>flow_gateway_to_processed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="gateway_cancellation_check" name="Vérification d&#x27;annulation" default="flow_gateway_to_processed">
      <bpmn:incoming>flow_process_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_to_notify</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_to_processed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="task_notify_cancellation" name="Notifier l&#x27;annulation au système de l&#x27;hôtel">
      <bpmn:incoming>flow_gateway_to_notify</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_start_to_process" name="" sourceRef="start_reservation" targetRef="task_process_reservation">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_process_to_gateway" name="" sourceRef="task_process_reservation" targetRef="gateway_cancellation_check">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_to_notify" name="Annulation détectée" sourceRef="gateway_cancellation_check" targetRef="task_notify_cancellation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Le client annule sa réservation</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_cancel_subprocess_to_main" name="" sourceRef="subprocess_cancellation" targetRef="end_reservation_processed">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_to_processed" name="Pas d&#x27;annulation" sourceRef="gateway_cancellation_check" targetRef="end_reservation_processed">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_client_process" name="Client" isExecutable="true">
    <bpmn:intermediateCatchEvent id="intermediate_cancel_event" name="Annulation de la réservation">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_client&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:messageEventDefinition id="intermediate_cancel_event_def">
      </bpmn:messageEventDefinition>
    </bpmn:intermediateCatchEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_reservation_cancellation">
      <bpmndi:BPMNShape id="pool_hotel_di" bpmnElement="pool_hotel" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="1616" height="336" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_client_di" bpmnElement="pool_client" isHorizontal="true">
        <dc:Bounds x="60" y="426" width="896" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_reservation_di" bpmnElement="start_reservation">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_process_reservation_di" bpmnElement="task_process_reservation">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="intermediate_cancel_event_di" bpmnElement="intermediate_cancel_event">
        <dc:Bounds x="760" y="466" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="subprocess_cancellation_di" bpmnElement="subprocess_cancellation" isExpanded="true">
        <dc:Bounds x="920" y="90" width="596" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_cancellation_subprocess_di" bpmnElement="start_cancellation_subprocess">
        <dc:Bounds x="960" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_refund_client_di" bpmnElement="task_refund_client">
        <dc:Bounds x="1120" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_release_room_di" bpmnElement="task_release_room">
        <dc:Bounds x="1280" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_cancellation_subprocess_di" bpmnElement="end_cancellation_subprocess">
        <dc:Bounds x="1440" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_reservation_processed_di" bpmnElement="end_reservation_processed">
        <dc:Bounds x="600" y="280" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_cancellation_check_di" bpmnElement="gateway_cancellation_check">
        <dc:Bounds x="440" y="90" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_notify_cancellation_di" bpmnElement="task_notify_cancellation">
        <dc:Bounds x="600" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_process_di" bpmnElement="flow_start_to_process">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_process_to_gateway_di" bpmnElement="flow_process_to_gateway">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="115" />
        <di:waypoint x="440" y="115" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_to_notify_di" bpmnElement="flow_gateway_to_notify">
        <di:waypoint x="490" y="115" />
        <di:waypoint x="545" y="115" />
        <di:waypoint x="545" y="130" />
        <di:waypoint x="600" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="110" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_start_cancel_to_refund_di" bpmnElement="flow_start_cancel_to_refund">
        <di:waypoint x="996" y="158" />
        <di:waypoint x="1058" y="158" />
        <di:waypoint x="1058" y="180" />
        <di:waypoint x="1120" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_refund_to_release_di" bpmnElement="flow_refund_to_release">
        <di:waypoint x="1220" y="180" />
        <di:waypoint x="1280" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_release_to_end_cancel_di" bpmnElement="flow_release_to_end_cancel">
        <di:waypoint x="1380" y="180" />
        <di:waypoint x="1410" y="180" />
        <di:waypoint x="1410" y="158" />
        <di:waypoint x="1440" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_cancel_subprocess_to_main_di" bpmnElement="flow_cancel_subprocess_to_main">
        <di:waypoint x="1516" y="170" />
        <di:waypoint x="1546" y="170" />
        <di:waypoint x="1546" y="358" />
        <di:waypoint x="570" y="358" />
        <di:waypoint x="570" y="298" />
        <di:waypoint x="600" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_to_processed_di" bpmnElement="flow_gateway_to_processed">
        <di:waypoint x="490" y="115" />
        <di:waypoint x="545" y="115" />
        <di:waypoint x="545" y="298" />
        <di:waypoint x="600" y="298" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="278" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_notify_to_cancel_event_di" bpmnElement="flow_notify_to_cancel_event">
        <di:waypoint x="700" y="130" />
        <di:waypoint x="730" y="130" />
        <di:waypoint x="730" y="484" />
        <di:waypoint x="760" y="484" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_cancel_to_subprocess_di" bpmnElement="flow_cancel_to_subprocess">
        <di:waypoint x="796" y="484" />
        <di:waypoint x="858" y="484" />
        <di:waypoint x="858" y="170" />
        <di:waypoint x="920" y="170" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>