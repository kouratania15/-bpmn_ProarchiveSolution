<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_commande"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_expedier_alarme" name="Dépassement délai" />
  <bpmn:collaboration id="Collaboration_process_commande">
    <bpmn:participant id="pool_fournisseur" name="Fournisseur" processRef="pool_fournisseur_process" />
    <bpmn:participant id="pool_responsable_achats" name="Responsable des achats" processRef="pool_responsable_achats_process" />
    <bpmn:messageFlow id="flow_expedier_alarme" name="Dépassement délai" sourceRef="task_expedier_commande" targetRef="end_commande_retard" messageRef="Message_flow_expedier_alarme" />
  </bpmn:collaboration>
  <bpmn:process id="pool_fournisseur_process" name="Fournisseur" isExecutable="true">
    <bpmn:startEvent id="start_commande_recue" name="Commande reçue">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_fournisseur&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_recevoir</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_recevoir_commande" name="Recevoir une commande">
      <bpmn:incoming>flow_start_recevoir</bpmn:incoming>
      <bpmn:outgoing>flow_recevoir_preparer</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_preparer_commande" name="Préparer une commande">
      <bpmn:incoming>flow_recevoir_preparer</bpmn:incoming>
      <bpmn:outgoing>flow_preparer_expedier</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_expedier_commande" name="Expédier une commande">
      <bpmn:incoming>flow_preparer_expedier</bpmn:incoming>
      <bpmn:outgoing>flow_expedier_end_succes</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_commande_expediee" name="Commande expédiée sous délai">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_fournisseur&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_expedier_end_succes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_recevoir" name="" sourceRef="start_commande_recue" targetRef="task_recevoir_commande">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_recevoir_preparer" name="" sourceRef="task_recevoir_commande" targetRef="task_preparer_commande">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_preparer_expedier" name="" sourceRef="task_preparer_commande" targetRef="task_expedier_commande">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_expedier_end_succes" name="" sourceRef="task_expedier_commande" targetRef="end_commande_expediee">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_responsable_achats_process" name="Responsable des achats" isExecutable="true">
    <bpmn:boundaryEvent id="timer_48h" name="Dépassement délai d&#x27;expédition" attachedToRef="task_expedier_commande" cancelActivity="true">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_responsable_achats&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_timer_alarme</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timer_48h_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="task_envoyer_alarme" name="Envoyer une alerte">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_responsable_achats&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_timer_alarme</bpmn:incoming>
      <bpmn:outgoing>flow_alarme_end_retard</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_commande_retard" name="Commande non expédiée à temps">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_responsable_achats&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_alarme_end_retard</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_timer_alarme" name="" sourceRef="timer_48h" targetRef="task_envoyer_alarme">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_alarme_end_retard" name="" sourceRef="task_envoyer_alarme" targetRef="end_commande_retard">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_commande">
      <bpmndi:BPMNShape id="pool_fournisseur_di" bpmnElement="pool_fournisseur" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="896" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_responsable_achats_di" bpmnElement="pool_responsable_achats" isHorizontal="true">
        <dc:Bounds x="60" y="280" width="416" height="256" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_commande_recue_di" bpmnElement="start_commande_recue">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_recevoir_commande_di" bpmnElement="task_recevoir_commande">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_preparer_commande_di" bpmnElement="task_preparer_commande">
        <dc:Bounds x="440" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_expedier_commande_di" bpmnElement="task_expedier_commande">
        <dc:Bounds x="600" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="timer_48h_di" bpmnElement="timer_48h">
        <dc:Bounds x="682" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_envoyer_alarme_di" bpmnElement="task_envoyer_alarme">
        <dc:Bounds x="120" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_commande_expediee_di" bpmnElement="end_commande_expediee">
        <dc:Bounds x="760" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_commande_retard_di" bpmnElement="end_commande_retard">
        <dc:Bounds x="280" y="430" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_recevoir_di" bpmnElement="flow_start_recevoir">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_recevoir_preparer_di" bpmnElement="flow_recevoir_preparer">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="440" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_preparer_expedier_di" bpmnElement="flow_preparer_expedier">
        <di:waypoint x="540" y="130" />
        <di:waypoint x="600" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_expedier_end_succes_di" bpmnElement="flow_expedier_end_succes">
        <di:waypoint x="700" y="130" />
        <di:waypoint x="730" y="130" />
        <di:waypoint x="730" y="108" />
        <di:waypoint x="760" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_timer_alarme_di" bpmnElement="flow_timer_alarme">
        <di:waypoint x="700" y="188" />
        <di:waypoint x="730" y="188" />
        <di:waypoint x="730" y="420" />
        <di:waypoint x="90" y="420" />
        <di:waypoint x="90" y="360" />
        <di:waypoint x="120" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_alarme_end_retard_di" bpmnElement="flow_alarme_end_retard">
        <di:waypoint x="220" y="360" />
        <di:waypoint x="250" y="360" />
        <di:waypoint x="250" y="448" />
        <di:waypoint x="280" y="448" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_expedier_alarme_di" bpmnElement="flow_expedier_alarme">
        <di:waypoint x="700" y="130" />
        <di:waypoint x="730" y="130" />
        <di:waypoint x="730" y="508" />
        <di:waypoint x="250" y="508" />
        <di:waypoint x="250" y="448" />
        <di:waypoint x="280" y="448" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="230" y="488" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>