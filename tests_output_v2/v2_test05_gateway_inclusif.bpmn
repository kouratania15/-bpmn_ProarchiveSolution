<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_signalement_probleme"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_process_signalement_probleme">
    <bpmn:participant id="pool_gestion_immobiliere" name="Gestion Immobilière" processRef="process_signalement_probleme" />
  </bpmn:collaboration>
  <bpmn:process id="process_signalement_probleme" name="Gestion Immobilière" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_locataire" name="Locataire">
        <bpmn:flowNodeRef>task_signalement</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_plombier" name="Plombier">
        <bpmn:flowNodeRef>task_plombier</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_electricien" name="Électricien">
        <bpmn:flowNodeRef>task_electricien</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_gestionnaire" name="Gestionnaire">
        <bpmn:flowNodeRef>task_cloture</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_signalement" name="Détection d&#x27;un problème">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_gestion_immobiliere&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_signalement</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_signalement" name="Signaler un problème">
      <bpmn:incoming>flow_start_signalement</bpmn:incoming>
      <bpmn:outgoing>flow_signalement_gateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="gateway_type_probleme" name="Type de problème">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_gestion_immobiliere&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_signalement_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_plomberie</bpmn:outgoing>
      <bpmn:outgoing>flow_electricite</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="task_plombier" name="Intervenir en plomberie">
      <bpmn:incoming>flow_plomberie</bpmn:incoming>
      <bpmn:outgoing>flow_plombier_fusion</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_electricien" name="Intervenir en électricité">
      <bpmn:incoming>flow_electricite</bpmn:incoming>
      <bpmn:outgoing>flow_electricien_fusion</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="gateway_fusion_interventions" name="Interventions terminées">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_gestion_immobiliere&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_plombier_fusion</bpmn:incoming>
      <bpmn:incoming>flow_electricien_fusion</bpmn:incoming>
      <bpmn:outgoing>flow_fusion_cloture</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="task_cloture" name="Clôturer le signalement">
      <bpmn:incoming>flow_fusion_cloture</bpmn:incoming>
      <bpmn:outgoing>flow_cloture_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_signalement_cloture" name="Clôture du signalement">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_gestion_immobiliere&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_cloture_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_signalement" name="" sourceRef="start_signalement" targetRef="task_signalement">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_signalement_gateway" name="" sourceRef="task_signalement" targetRef="gateway_type_probleme">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_plomberie" name="Problème lié à la plomberie" sourceRef="gateway_type_probleme" targetRef="task_plombier">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_electricite" name="Problème lié à l&#x27;électricité" sourceRef="gateway_type_probleme" targetRef="task_electricien">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_plombier_fusion" name="" sourceRef="task_plombier" targetRef="gateway_fusion_interventions">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_electricien_fusion" name="" sourceRef="task_electricien" targetRef="gateway_fusion_interventions">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_fusion_cloture" name="" sourceRef="gateway_fusion_interventions" targetRef="task_cloture">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_cloture_end" name="" sourceRef="task_cloture" targetRef="end_signalement_cloture">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_signalement_probleme">
      <bpmndi:BPMNShape id="pool_gestion_immobiliere_di" bpmnElement="pool_gestion_immobiliere" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="1140" height="760" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_locataire_di" bpmnElement="lane_locataire" isHorizontal="true">
        <dc:Bounds x="90" y="50" width="1110" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_plombier_di" bpmnElement="lane_plombier" isHorizontal="true">
        <dc:Bounds x="90" y="240" width="1110" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_electricien_di" bpmnElement="lane_electricien" isHorizontal="true">
        <dc:Bounds x="90" y="430" width="1110" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_gestionnaire_di" bpmnElement="lane_gestionnaire" isHorizontal="true">
        <dc:Bounds x="90" y="620" width="1110" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_signalement_di" bpmnElement="start_signalement">
        <dc:Bounds x="120" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_signalement_di" bpmnElement="task_signalement">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_type_probleme_di" bpmnElement="gateway_type_probleme">
        <dc:Bounds x="440" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_plombier_di" bpmnElement="task_plombier">
        <dc:Bounds x="600" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_electricien_di" bpmnElement="task_electricien">
        <dc:Bounds x="600" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_fusion_interventions_di" bpmnElement="gateway_fusion_interventions">
        <dc:Bounds x="760" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_cloture_di" bpmnElement="task_cloture">
        <dc:Bounds x="920" y="660" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_signalement_cloture_di" bpmnElement="end_signalement_cloture">
        <dc:Bounds x="1080" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_signalement_di" bpmnElement="flow_start_signalement">
        <di:waypoint x="156" y="98" />
        <di:waypoint x="218" y="98" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_signalement_gateway_di" bpmnElement="flow_signalement_gateway">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="105" />
        <di:waypoint x="440" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_plomberie_di" bpmnElement="flow_plomberie">
        <di:waypoint x="490" y="105" />
        <di:waypoint x="545" y="105" />
        <di:waypoint x="545" y="320" />
        <di:waypoint x="600" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="300" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_electricite_di" bpmnElement="flow_electricite">
        <di:waypoint x="490" y="105" />
        <di:waypoint x="545" y="105" />
        <di:waypoint x="545" y="510" />
        <di:waypoint x="600" y="510" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="490" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_plombier_fusion_di" bpmnElement="flow_plombier_fusion">
        <di:waypoint x="700" y="320" />
        <di:waypoint x="730" y="320" />
        <di:waypoint x="730" y="105" />
        <di:waypoint x="760" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_electricien_fusion_di" bpmnElement="flow_electricien_fusion">
        <di:waypoint x="700" y="510" />
        <di:waypoint x="730" y="510" />
        <di:waypoint x="730" y="105" />
        <di:waypoint x="760" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_fusion_cloture_di" bpmnElement="flow_fusion_cloture">
        <di:waypoint x="810" y="105" />
        <di:waypoint x="865" y="105" />
        <di:waypoint x="865" y="700" />
        <di:waypoint x="920" y="700" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_cloture_end_di" bpmnElement="flow_cloture_end">
        <di:waypoint x="1020" y="700" />
        <di:waypoint x="1050" y="700" />
        <di:waypoint x="1050" y="98" />
        <di:waypoint x="1080" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>