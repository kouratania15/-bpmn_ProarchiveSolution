<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_consultation_medicale"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_process_consultation_medicale">
    <bpmn:participant id="pool_clinique" name="Clinique Médicale" processRef="process_consultation_medicale" />
  </bpmn:collaboration>
  <bpmn:process id="process_consultation_medicale" name="Clinique Médicale" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_patient" name="Patient">
        <bpmn:flowNodeRef>task_prendre_rendez-vous</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_infirmière" name="Infirmière">
        <bpmn:flowNodeRef>task_preparer_dossier</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_medecin" name="Médecin">
        <bpmn:flowNodeRef>task_recevoir_patient</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_event" name="Début du processus">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_clinique&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_rendez-vous</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_prendre_rendez-vous" name="Prendre rendez-vous">
      <bpmn:incoming>flow_start_rendez-vous</bpmn:incoming>
      <bpmn:outgoing>flow_rendez-vous_dossier</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_preparer_dossier" name="Préparer le dossier médical">
      <bpmn:incoming>flow_rendez-vous_dossier</bpmn:incoming>
      <bpmn:outgoing>flow_dossier_consultation</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_recevoir_patient" name="Recevoir le patient en consultation">
      <bpmn:incoming>flow_dossier_consultation</bpmn:incoming>
      <bpmn:outgoing>flow_consultation_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_event" name="Fin de la consultation">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_clinique&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_consultation_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_rendez-vous" name="" sourceRef="start_event" targetRef="task_prendre_rendez-vous">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_rendez-vous_dossier" name="" sourceRef="task_prendre_rendez-vous" targetRef="task_preparer_dossier">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_dossier_consultation" name="" sourceRef="task_preparer_dossier" targetRef="task_recevoir_patient">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_consultation_end" name="" sourceRef="task_recevoir_patient" targetRef="end_event">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_consultation_medicale">
      <bpmndi:BPMNShape id="pool_clinique_di" bpmnElement="pool_clinique" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="900" height="570" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_patient_di" bpmnElement="lane_patient" isHorizontal="true">
        <dc:Bounds x="90" y="50" width="870" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_infirmière_di" bpmnElement="lane_infirmière" isHorizontal="true">
        <dc:Bounds x="90" y="240" width="870" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_medecin_di" bpmnElement="lane_medecin" isHorizontal="true">
        <dc:Bounds x="90" y="430" width="870" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_di" bpmnElement="start_event">
        <dc:Bounds x="120" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prendre_rendez-vous_di" bpmnElement="task_prendre_rendez-vous">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_preparer_dossier_di" bpmnElement="task_preparer_dossier">
        <dc:Bounds x="440" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_recevoir_patient_di" bpmnElement="task_recevoir_patient">
        <dc:Bounds x="600" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_di" bpmnElement="end_event">
        <dc:Bounds x="760" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_rendez-vous_di" bpmnElement="flow_start_rendez-vous">
        <di:waypoint x="156" y="98" />
        <di:waypoint x="218" y="98" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_rendez-vous_dossier_di" bpmnElement="flow_rendez-vous_dossier">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="320" />
        <di:waypoint x="440" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_dossier_consultation_di" bpmnElement="flow_dossier_consultation">
        <di:waypoint x="540" y="320" />
        <di:waypoint x="570" y="320" />
        <di:waypoint x="570" y="510" />
        <di:waypoint x="600" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_consultation_end_di" bpmnElement="flow_consultation_end">
        <di:waypoint x="700" y="510" />
        <di:waypoint x="730" y="510" />
        <di:waypoint x="730" y="98" />
        <di:waypoint x="760" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>