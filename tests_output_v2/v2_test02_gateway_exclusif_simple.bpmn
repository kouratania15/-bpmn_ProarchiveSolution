<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_recrutement_postulation"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_postuler_examiner" name="flow_postuler_examiner" />
  <bpmn:collaboration id="Collaboration_process_recrutement_postulation">
    <bpmn:participant id="pool_candidat" name="Candidat" processRef="pool_candidat_process" />
    <bpmn:participant id="pool_recruteur" name="Recruteur" processRef="pool_recruteur_process" />
    <bpmn:messageFlow id="flow_postuler_examiner" name="" sourceRef="task_postuler" targetRef="task_examiner_cv" messageRef="Message_flow_postuler_examiner" />
  </bpmn:collaboration>
  <bpmn:process id="pool_candidat_process" name="Candidat" isExecutable="true">
    <bpmn:startEvent id="start_postulation" name="Postulation à une offre d&#x27;emploi">
      <bpmn:outgoing>flow_start_postuler</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_postuler" name="Postuler à une offre d&#x27;emploi">
      <bpmn:incoming>flow_start_postuler</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_start_postuler" name="" sourceRef="start_postulation" targetRef="task_postuler">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_recruteur_process" name="Recruteur" isExecutable="true">
    <bpmn:task id="task_examiner_cv" name="Examiner le CV">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_recruteur&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_examiner_decision</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_decision_profil" name="Profil correspondant ?">
      <bpmn:incoming>flow_examiner_decision</bpmn:incoming>
      <bpmn:outgoing>flow_decision_entretien</bpmn:outgoing>
      <bpmn:outgoing>flow_decision_reponse_negative</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="task_planifier_entretien" name="Planifier un entretien">
      <bpmn:incoming>flow_decision_entretien</bpmn:incoming>
      <bpmn:outgoing>flow_entretien_planifie_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_envoyer_reponse_negative" name="Envoyer une réponse négative">
      <bpmn:incoming>flow_decision_reponse_negative</bpmn:incoming>
      <bpmn:outgoing>flow_reponse_negative_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_entretien_planifie" name="Entretien planifié">
      <bpmn:incoming>flow_entretien_planifie_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_reponse_negative" name="Réponse négative envoyée">
      <bpmn:incoming>flow_reponse_negative_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_examiner_decision" name="" sourceRef="task_examiner_cv" targetRef="gateway_decision_profil">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_decision_entretien" name="Profil correspondant" sourceRef="gateway_decision_profil" targetRef="task_planifier_entretien">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">le profil correspond au poste</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_entretien_planifie_end" name="" sourceRef="task_planifier_entretien" targetRef="end_entretien_planifie">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_decision_reponse_negative" name="Profil non correspondant" sourceRef="gateway_decision_profil" targetRef="task_envoyer_reponse_negative">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">le profil ne correspond pas au poste</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_reponse_negative_end" name="" sourceRef="task_envoyer_reponse_negative" targetRef="end_reponse_negative">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_recrutement_postulation">
      <bpmndi:BPMNShape id="pool_candidat_di" bpmnElement="pool_candidat" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="480" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_recruteur_di" bpmnElement="pool_recruteur" isHorizontal="true">
        <dc:Bounds x="60" y="280" width="1056" height="366" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_postulation_di" bpmnElement="start_postulation">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_postuler_di" bpmnElement="task_postuler">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_examiner_cv_di" bpmnElement="task_examiner_cv">
        <dc:Bounds x="440" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_decision_profil_di" bpmnElement="gateway_decision_profil">
        <dc:Bounds x="600" y="320" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_planifier_entretien_di" bpmnElement="task_planifier_entretien">
        <dc:Bounds x="760" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_envoyer_reponse_negative_di" bpmnElement="task_envoyer_reponse_negative">
        <dc:Bounds x="760" y="496" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_entretien_planifie_di" bpmnElement="end_entretien_planifie">
        <dc:Bounds x="920" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_reponse_negative_di" bpmnElement="end_reponse_negative">
        <dc:Bounds x="920" y="430" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_postuler_di" bpmnElement="flow_start_postuler">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_examiner_decision_di" bpmnElement="flow_examiner_decision">
        <di:waypoint x="540" y="360" />
        <di:waypoint x="570" y="360" />
        <di:waypoint x="570" y="345" />
        <di:waypoint x="600" y="345" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_decision_entretien_di" bpmnElement="flow_decision_entretien">
        <di:waypoint x="650" y="345" />
        <di:waypoint x="705" y="345" />
        <di:waypoint x="705" y="360" />
        <di:waypoint x="760" y="360" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="340" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_entretien_planifie_end_di" bpmnElement="flow_entretien_planifie_end">
        <di:waypoint x="860" y="360" />
        <di:waypoint x="890" y="360" />
        <di:waypoint x="890" y="338" />
        <di:waypoint x="920" y="338" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_decision_reponse_negative_di" bpmnElement="flow_decision_reponse_negative">
        <di:waypoint x="650" y="345" />
        <di:waypoint x="705" y="345" />
        <di:waypoint x="705" y="536" />
        <di:waypoint x="760" y="536" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="516" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reponse_negative_end_di" bpmnElement="flow_reponse_negative_end">
        <di:waypoint x="860" y="536" />
        <di:waypoint x="890" y="536" />
        <di:waypoint x="890" y="448" />
        <di:waypoint x="920" y="448" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_postuler_examiner_di" bpmnElement="flow_postuler_examiner">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="360" />
        <di:waypoint x="440" y="360" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>