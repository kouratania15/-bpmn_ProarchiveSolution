<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_medical_analysis"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_prescribe_lab" name="flow_prescribe_lab" />
  <bpmn:message id="Message_flow_anormal_examine" name="flow_anormal_examine" />
  <bpmn:message id="Message_flow_normal_inform" name="flow_normal_inform" />
  <bpmn:collaboration id="Collaboration_process_medical_analysis">
    <bpmn:participant id="pool_clinic" name="Clinique" processRef="pool_clinic_process" />
    <bpmn:participant id="pool_lab" name="Laboratoire" processRef="pool_lab_process" />
    <bpmn:messageFlow id="flow_prescribe_lab" name="" sourceRef="task_prescribe_blood_test" targetRef="task_lab_analysis" messageRef="Message_flow_prescribe_lab" />
    <bpmn:messageFlow id="flow_anormal_examine" name="" sourceRef="intermediate_catch_anormal_results" targetRef="task_examine_patient" messageRef="Message_flow_anormal_examine" />
    <bpmn:messageFlow id="flow_normal_inform" name="" sourceRef="intermediate_catch_normal_results" targetRef="task_inform_normal" messageRef="Message_flow_normal_inform" />
  </bpmn:collaboration>
  <bpmn:process id="pool_clinic_process" name="Clinique" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_patient" name="Patient">
        <bpmn:flowNodeRef>task_consult_physician</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_traitant" name="Médecin traitant">
        <bpmn:flowNodeRef>task_prescribe_blood_test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_inform_normal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_specialiste" name="Spécialiste">
        <bpmn:flowNodeRef>task_examine_patient</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_consultation" name="Consultation initiale">
      <bpmn:outgoing>flow_start_consult</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_consult_physician" name="Consulter le médecin traitant">
      <bpmn:incoming>flow_start_consult</bpmn:incoming>
      <bpmn:outgoing>flow_consult_prescribe</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_prescribe_blood_test" name="Prescrire une analyse de sang">
      <bpmn:incoming>flow_consult_prescribe</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="task_examine_patient" name="Examiner le patient">
      <bpmn:outgoing>flow_examine_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_inform_normal" name="Informer le patient que tout est normal">
      <bpmn:outgoing>flow_inform_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_consultation_normal" name="Information normale au patient">
      <bpmn:incoming>flow_inform_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_consultation_specialist" name="Consultation spécialisée terminée">
      <bpmn:incoming>flow_examine_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_consult" name="" sourceRef="start_consultation" targetRef="task_consult_physician">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_consult_prescribe" name="" sourceRef="task_consult_physician" targetRef="task_prescribe_blood_test">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_examine_end" name="" sourceRef="task_examine_patient" targetRef="end_consultation_specialist">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_inform_end" name="" sourceRef="task_inform_normal" targetRef="end_consultation_normal">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_lab_process" name="Laboratoire" isExecutable="true">
    <bpmn:task id="task_lab_analysis" name="Réaliser l&#x27;analyse de sang">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_lab&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_lab_gateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_analysis_results" name="Résultats de l&#x27;analyse">
      <bpmn:incoming>flow_lab_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_anormal</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_normal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="intermediate_catch_anormal_results" name="Résultats anormaux">
      <bpmn:incoming>flow_gateway_anormal</bpmn:incoming>
      <bpmn:messageEventDefinition id="intermediate_catch_anormal_results_def">
      </bpmn:messageEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="intermediate_catch_normal_results" name="Résultats normaux">
      <bpmn:incoming>flow_gateway_normal</bpmn:incoming>
      <bpmn:messageEventDefinition id="intermediate_catch_normal_results_def">
      </bpmn:messageEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="start_pool_lab" name="Start Laboratoire">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_lab_gateway" name="" sourceRef="task_lab_analysis" targetRef="gateway_analysis_results">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_anormal" name="Résultats anormaux" sourceRef="gateway_analysis_results" targetRef="intermediate_catch_anormal_results">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_normal" name="Résultats normaux" sourceRef="gateway_analysis_results" targetRef="intermediate_catch_normal_results">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_1" name="" sourceRef="start_pool_lab" targetRef="task_lab_analysis">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_medical_analysis">
      <bpmndi:BPMNShape id="pool_clinic_di" bpmnElement="pool_clinic" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="980" height="680" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_lab_di" bpmnElement="pool_lab" isHorizontal="true">
        <dc:Bounds x="60" y="770" width="736" height="322" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_patient_di" bpmnElement="lane_patient" isHorizontal="true">
        <dc:Bounds x="90" y="50" width="950" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_traitant_di" bpmnElement="lane_traitant" isHorizontal="true">
        <dc:Bounds x="90" y="240" width="950" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_specialiste_di" bpmnElement="lane_specialiste" isHorizontal="true">
        <dc:Bounds x="90" y="540" width="950" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_consultation_di" bpmnElement="start_consultation">
        <dc:Bounds x="120" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_consult_physician_di" bpmnElement="task_consult_physician">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_prescribe_blood_test_di" bpmnElement="task_prescribe_blood_test">
        <dc:Bounds x="440" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_lab_analysis_di" bpmnElement="task_lab_analysis">
        <dc:Bounds x="280" y="942" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_analysis_results_di" bpmnElement="gateway_analysis_results">
        <dc:Bounds x="440" y="942" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="intermediate_catch_anormal_results_di" bpmnElement="intermediate_catch_anormal_results">
        <dc:Bounds x="600" y="810" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_examine_patient_di" bpmnElement="task_examine_patient">
        <dc:Bounds x="760" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="intermediate_catch_normal_results_di" bpmnElement="intermediate_catch_normal_results">
        <dc:Bounds x="600" y="876" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_inform_normal_di" bpmnElement="task_inform_normal">
        <dc:Bounds x="760" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_consultation_normal_di" bpmnElement="end_consultation_normal">
        <dc:Bounds x="920" y="166" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_consultation_specialist_di" bpmnElement="end_consultation_specialist">
        <dc:Bounds x="920" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_pool_lab_di" bpmnElement="start_pool_lab">
        <dc:Bounds x="120" y="876" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_consult_di" bpmnElement="flow_start_consult">
        <di:waypoint x="156" y="98" />
        <di:waypoint x="218" y="98" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_consult_prescribe_di" bpmnElement="flow_consult_prescribe">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="320" />
        <di:waypoint x="440" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_lab_gateway_di" bpmnElement="flow_lab_gateway">
        <di:waypoint x="380" y="982" />
        <di:waypoint x="410" y="982" />
        <di:waypoint x="410" y="967" />
        <di:waypoint x="440" y="967" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_anormal_di" bpmnElement="flow_gateway_anormal">
        <di:waypoint x="490" y="967" />
        <di:waypoint x="545" y="967" />
        <di:waypoint x="545" y="828" />
        <di:waypoint x="600" y="828" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="808" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_examine_end_di" bpmnElement="flow_examine_end">
        <di:waypoint x="860" y="620" />
        <di:waypoint x="890" y="620" />
        <di:waypoint x="890" y="98" />
        <di:waypoint x="920" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_normal_di" bpmnElement="flow_gateway_normal">
        <di:waypoint x="490" y="967" />
        <di:waypoint x="545" y="967" />
        <di:waypoint x="545" y="894" />
        <di:waypoint x="600" y="894" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="874" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_inform_end_di" bpmnElement="flow_inform_end">
        <di:waypoint x="860" y="430" />
        <di:waypoint x="890" y="430" />
        <di:waypoint x="890" y="184" />
        <di:waypoint x="920" y="184" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="156" y="894" />
        <di:waypoint x="218" y="894" />
        <di:waypoint x="218" y="982" />
        <di:waypoint x="280" y="982" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_prescribe_lab_di" bpmnElement="flow_prescribe_lab">
        <di:waypoint x="540" y="320" />
        <di:waypoint x="570" y="320" />
        <di:waypoint x="570" y="1042" />
        <di:waypoint x="250" y="1042" />
        <di:waypoint x="250" y="982" />
        <di:waypoint x="280" y="982" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_anormal_examine_di" bpmnElement="flow_anormal_examine">
        <di:waypoint x="636" y="828" />
        <di:waypoint x="698" y="828" />
        <di:waypoint x="698" y="620" />
        <di:waypoint x="760" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_normal_inform_di" bpmnElement="flow_normal_inform">
        <di:waypoint x="636" y="894" />
        <di:waypoint x="698" y="894" />
        <di:waypoint x="698" y="430" />
        <di:waypoint x="760" y="430" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>