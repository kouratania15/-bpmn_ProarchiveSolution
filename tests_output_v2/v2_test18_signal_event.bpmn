<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_intrusion_response"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_message_flow_alarm" name="Signal d&#x27;alarme" />
  <bpmn:message id="Message_flow_catch_alarm_transmit" name="flow_catch_alarm_transmit" />
  <bpmn:message id="Message_flow_lock_end" name="flow_lock_end" />
  <bpmn:collaboration id="Collaboration_process_intrusion_response">
    <bpmn:participant id="pool_security_service" name="Service de sécurité" processRef="pool_security_service_process" />
    <bpmn:participant id="pool_night_team" name="Équipe de nuit" processRef="pool_night_team_process" />
    <bpmn:messageFlow id="message_flow_alarm" name="Signal d&#x27;alarme" sourceRef="intermediate_throw_alarm" targetRef="intermediate_catch_alarm" messageRef="Message_message_flow_alarm" />
    <bpmn:messageFlow id="flow_catch_alarm_transmit" name="" sourceRef="intermediate_catch_alarm" targetRef="task_transmit_decision" messageRef="Message_flow_catch_alarm_transmit" />
    <bpmn:messageFlow id="flow_lock_end" name="" sourceRef="task_lock_access" targetRef="end_process_completed" messageRef="Message_flow_lock_end" />
  </bpmn:collaboration>
  <bpmn:process id="pool_security_service_process" name="Service de sécurité" isExecutable="true">
    <bpmn:startEvent id="start_intrusion_detection" name="Détection d&#x27;intrusion">
      <bpmn:outgoing>flow_start_detect</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_detect_intrusion" name="Détecter une intrusion">
      <bpmn:incoming>flow_start_detect</bpmn:incoming>
      <bpmn:outgoing>flow_detect_trigger</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_trigger_alarm" name="Déclencher un signal d&#x27;alarme générale">
      <bpmn:incoming>flow_detect_trigger</bpmn:incoming>
      <bpmn:outgoing>flow_trigger_throw_alarm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="intermediate_throw_alarm" name="Signal d&#x27;alarme générale">
      <bpmn:incoming>flow_trigger_throw_alarm</bpmn:incoming>
      <bpmn:signalEventDefinition id="intermediate_throw_alarm_def">
      </bpmn:signalEventDefinition>
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="task_lock_access" name="Verrouiller automatiquement les accès">
      <bpmn:incoming>flow_transmit_lock</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="task_transmit_decision" name="Transmettre la décision de verrouillage">
      <bpmn:outgoing>flow_transmit_lock</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_start_detect" name="" sourceRef="start_intrusion_detection" targetRef="task_detect_intrusion">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_detect_trigger" name="" sourceRef="task_detect_intrusion" targetRef="task_trigger_alarm">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_trigger_throw_alarm" name="" sourceRef="task_trigger_alarm" targetRef="intermediate_throw_alarm">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_transmit_lock" name="Décision de verrouillage" sourceRef="task_transmit_decision" targetRef="task_lock_access">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_night_team_process" name="Équipe de nuit" isExecutable="true">
    <bpmn:intermediateCatchEvent id="intermediate_catch_alarm" name="Réception du signal d&#x27;alarme">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_night_team&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_catch_evacuate</bpmn:outgoing>
      <bpmn:signalEventDefinition id="intermediate_catch_alarm_def">
      </bpmn:signalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="task_evacuate_site" name="Évacuer les lieux">
      <bpmn:incoming>flow_catch_evacuate</bpmn:incoming>
      <bpmn:outgoing>flow_evacuate_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_process_completed" name="Processus terminé : Intrusion gérée">
      <bpmn:incoming>flow_evacuate_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_catch_evacuate" name="" sourceRef="intermediate_catch_alarm" targetRef="task_evacuate_site">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_evacuate_end" name="" sourceRef="task_evacuate_site" targetRef="end_process_completed">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_intrusion_response">
      <bpmndi:BPMNShape id="pool_security_service_di" bpmnElement="pool_security_service" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="1280" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_night_team_di" bpmnElement="pool_night_team" isHorizontal="true">
        <dc:Bounds x="60" y="280" width="1216" height="256" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_intrusion_detection_di" bpmnElement="start_intrusion_detection">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_detect_intrusion_di" bpmnElement="task_detect_intrusion">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_trigger_alarm_di" bpmnElement="task_trigger_alarm">
        <dc:Bounds x="440" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="intermediate_throw_alarm_di" bpmnElement="intermediate_throw_alarm">
        <dc:Bounds x="600" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="intermediate_catch_alarm_di" bpmnElement="intermediate_catch_alarm">
        <dc:Bounds x="760" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_evacuate_site_di" bpmnElement="task_evacuate_site">
        <dc:Bounds x="920" y="386" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_lock_access_di" bpmnElement="task_lock_access">
        <dc:Bounds x="1080" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_transmit_decision_di" bpmnElement="task_transmit_decision">
        <dc:Bounds x="920" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_process_completed_di" bpmnElement="end_process_completed">
        <dc:Bounds x="1080" y="386" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_detect_di" bpmnElement="flow_start_detect">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_detect_trigger_di" bpmnElement="flow_detect_trigger">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="440" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_trigger_throw_alarm_di" bpmnElement="flow_trigger_throw_alarm">
        <di:waypoint x="540" y="130" />
        <di:waypoint x="570" y="130" />
        <di:waypoint x="570" y="108" />
        <di:waypoint x="600" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_transmit_lock_di" bpmnElement="flow_transmit_lock">
        <di:waypoint x="1020" y="130" />
        <di:waypoint x="1080" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1060" y="110" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_catch_evacuate_di" bpmnElement="flow_catch_evacuate">
        <di:waypoint x="796" y="338" />
        <di:waypoint x="858" y="338" />
        <di:waypoint x="858" y="426" />
        <di:waypoint x="920" y="426" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_evacuate_end_di" bpmnElement="flow_evacuate_end">
        <di:waypoint x="1020" y="426" />
        <di:waypoint x="1050" y="426" />
        <di:waypoint x="1050" y="404" />
        <di:waypoint x="1080" y="404" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="message_flow_alarm_di" bpmnElement="message_flow_alarm">
        <di:waypoint x="636" y="108" />
        <di:waypoint x="698" y="108" />
        <di:waypoint x="698" y="338" />
        <di:waypoint x="760" y="338" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="678" y="318" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_catch_alarm_transmit_di" bpmnElement="flow_catch_alarm_transmit">
        <di:waypoint x="796" y="338" />
        <di:waypoint x="858" y="338" />
        <di:waypoint x="858" y="130" />
        <di:waypoint x="920" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_lock_end_di" bpmnElement="flow_lock_end">
        <di:waypoint x="1180" y="130" />
        <di:waypoint x="1210" y="130" />
        <di:waypoint x="1210" y="464" />
        <di:waypoint x="1050" y="464" />
        <di:waypoint x="1050" y="404" />
        <di:waypoint x="1080" y="404" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>