<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_checkin_baggage"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_process_checkin_baggage">
    <bpmn:participant id="pool_aeroport" name="Aéroport" processRef="process_checkin_baggage" />
  </bpmn:collaboration>
  <bpmn:process id="process_checkin_baggage" name="Aéroport" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_passager" name="Passager">
        <bpmn:flowNodeRef>task_register_baggage</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_agent" name="Agent">
        <bpmn:flowNodeRef>task_print_boarding_pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_orient_passenger</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_service_bagages" name="Service Bagages">
        <bpmn:flowNodeRef>task_label_baggage</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_checkin" name="Début du processus : Arrivée du passager">
      <bpmn:outgoing>flow_start_register</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_register_baggage" name="Enregistrer ses bagages">
      <bpmn:incoming>flow_start_register</bpmn:incoming>
      <bpmn:outgoing>flow_register_parallel</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_print_boarding_pass" name="Imprimer la carte d&#x27;embarquement">
      <bpmn:incoming>flow_print_boarding_pass</bpmn:incoming>
      <bpmn:outgoing>flow_print_to_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_label_baggage" name="Étiqueter la valise">
      <bpmn:incoming>flow_label_baggage</bpmn:incoming>
      <bpmn:outgoing>flow_label_to_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="parallel_gateway_checkin" name="Activités parallèles : Impression et étiquetage">
      <bpmn:incoming>flow_register_parallel</bpmn:incoming>
      <bpmn:outgoing>flow_print_boarding_pass</bpmn:outgoing>
      <bpmn:outgoing>flow_label_baggage</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="parallel_gateway_join_checkin" name="Convergence des activités parallèles">
      <bpmn:incoming>flow_print_to_join</bpmn:incoming>
      <bpmn:incoming>flow_label_to_join</bpmn:incoming>
      <bpmn:outgoing>flow_join_to_orient</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="task_orient_passenger" name="Orienté le passager vers la porte d&#x27;embarquement">
      <bpmn:incoming>flow_join_to_orient</bpmn:incoming>
      <bpmn:outgoing>flow_orient_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_checkin_completed" name="Fin des opérations d&#x27;enregistrement et d&#x27;étiquetage">
      <bpmn:incoming>flow_orient_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_register" name="" sourceRef="start_checkin" targetRef="task_register_baggage">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_register_parallel" name="" sourceRef="task_register_baggage" targetRef="parallel_gateway_checkin">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_print_boarding_pass" name="" sourceRef="parallel_gateway_checkin" targetRef="task_print_boarding_pass">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_label_baggage" name="" sourceRef="parallel_gateway_checkin" targetRef="task_label_baggage">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_print_to_join" name="" sourceRef="task_print_boarding_pass" targetRef="parallel_gateway_join_checkin">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_label_to_join" name="" sourceRef="task_label_baggage" targetRef="parallel_gateway_join_checkin">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_join_to_orient" name="" sourceRef="parallel_gateway_join_checkin" targetRef="task_orient_passenger">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_orient_end" name="" sourceRef="task_orient_passenger" targetRef="end_checkin_completed">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_checkin_baggage">
      <bpmndi:BPMNShape id="pool_aeroport_di" bpmnElement="pool_aeroport" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="1140" height="570" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_passager_di" bpmnElement="lane_passager" isHorizontal="true">
        <dc:Bounds x="90" y="50" width="1110" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_agent_di" bpmnElement="lane_agent" isHorizontal="true">
        <dc:Bounds x="90" y="240" width="1110" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_service_bagages_di" bpmnElement="lane_service_bagages" isHorizontal="true">
        <dc:Bounds x="90" y="430" width="1110" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_checkin_di" bpmnElement="start_checkin">
        <dc:Bounds x="120" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_register_baggage_di" bpmnElement="task_register_baggage">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_print_boarding_pass_di" bpmnElement="task_print_boarding_pass">
        <dc:Bounds x="600" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_label_baggage_di" bpmnElement="task_label_baggage">
        <dc:Bounds x="600" y="470" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="parallel_gateway_checkin_di" bpmnElement="parallel_gateway_checkin">
        <dc:Bounds x="440" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="parallel_gateway_join_checkin_di" bpmnElement="parallel_gateway_join_checkin">
        <dc:Bounds x="760" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_orient_passenger_di" bpmnElement="task_orient_passenger">
        <dc:Bounds x="920" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_checkin_completed_di" bpmnElement="end_checkin_completed">
        <dc:Bounds x="1080" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_register_di" bpmnElement="flow_start_register">
        <di:waypoint x="156" y="98" />
        <di:waypoint x="218" y="98" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_register_parallel_di" bpmnElement="flow_register_parallel">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="105" />
        <di:waypoint x="440" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_print_boarding_pass_di" bpmnElement="flow_print_boarding_pass">
        <di:waypoint x="490" y="105" />
        <di:waypoint x="545" y="105" />
        <di:waypoint x="545" y="320" />
        <di:waypoint x="600" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_label_baggage_di" bpmnElement="flow_label_baggage">
        <di:waypoint x="490" y="105" />
        <di:waypoint x="545" y="105" />
        <di:waypoint x="545" y="510" />
        <di:waypoint x="600" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_print_to_join_di" bpmnElement="flow_print_to_join">
        <di:waypoint x="700" y="320" />
        <di:waypoint x="730" y="320" />
        <di:waypoint x="730" y="105" />
        <di:waypoint x="760" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_label_to_join_di" bpmnElement="flow_label_to_join">
        <di:waypoint x="700" y="510" />
        <di:waypoint x="730" y="510" />
        <di:waypoint x="730" y="105" />
        <di:waypoint x="760" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_join_to_orient_di" bpmnElement="flow_join_to_orient">
        <di:waypoint x="810" y="105" />
        <di:waypoint x="865" y="105" />
        <di:waypoint x="865" y="320" />
        <di:waypoint x="920" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_orient_end_di" bpmnElement="flow_orient_end">
        <di:waypoint x="1020" y="320" />
        <di:waypoint x="1050" y="320" />
        <di:waypoint x="1050" y="98" />
        <di:waypoint x="1080" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>