{
  "process": {
    "id": "process_medical_analysis",
    "name": "Processus de consultation médicale et analyse de sang",
    "documentation": "Processus de suivi d'un patient depuis la consultation initiale jusqu'à la décision basée sur les résultats de l'analyse de sang."
  },
  "pools": [
    {
      "id": "pool_clinic",
      "name": "Clinique",
      "lanes": [
        {
          "id": "lane_patient",
          "name": "Patient"
        },
        {
          "id": "lane_traitant",
          "name": "Médecin traitant"
        },
        {
          "id": "lane_specialiste",
          "name": "Spécialiste"
        }
      ]
    },
    {
      "id": "pool_lab",
      "name": "Laboratoire"
    }
  ],
  "nodes": [
    {
      "id": "start_consultation",
      "type": "startEvent",
      "name": "Consultation initiale",
      "eventDefinition": "none",
      "sourceProcessElement": "event_1",
      "poolId": "pool_clinic"
    },
    {
      "id": "task_consult_physician",
      "type": "task",
      "name": "Consulter le médecin traitant",
      "poolId": "pool_clinic",
      "laneId": "lane_patient"
    },
    {
      "id": "task_prescribe_blood_test",
      "type": "task",
      "name": "Prescrire une analyse de sang",
      "poolId": "pool_clinic",
      "laneId": "lane_traitant"
    },
    {
      "id": "task_lab_analysis",
      "type": "task",
      "name": "Réaliser l'analyse de sang",
      "poolId": "pool_lab",
      "documentation": "GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool 'pool_lab' ; cohérence métier non garantie, à vérifier."
    },
    {
      "id": "gateway_analysis_results",
      "type": "exclusiveGateway",
      "name": "Résultats de l'analyse",
      "gatewayDirection": "diverging",
      "poolId": "pool_lab"
    },
    {
      "id": "intermediate_catch_anormal_results",
      "type": "intermediateCatchEvent",
      "name": "Résultats anormaux",
      "eventDefinition": "message",
      "poolId": "pool_lab"
    },
    {
      "id": "task_examine_patient",
      "type": "task",
      "name": "Examiner le patient",
      "poolId": "pool_clinic",
      "laneId": "lane_specialiste"
    },
    {
      "id": "intermediate_catch_normal_results",
      "type": "intermediateCatchEvent",
      "name": "Résultats normaux",
      "eventDefinition": "message",
      "poolId": "pool_lab"
    },
    {
      "id": "task_inform_normal",
      "type": "task",
      "name": "Informer le patient que tout est normal",
      "poolId": "pool_clinic",
      "laneId": "lane_traitant"
    },
    {
      "id": "end_consultation_normal",
      "type": "endEvent",
      "name": "Information normale au patient",
      "eventDefinition": "none",
      "poolId": "pool_clinic"
    },
    {
      "id": "end_consultation_specialist",
      "type": "endEvent",
      "name": "Consultation spécialisée terminée",
      "eventDefinition": "none",
      "poolId": "pool_clinic"
    },
    {
      "id": "start_pool_lab",
      "type": "startEvent",
      "name": "Start Laboratoire",
      "poolId": "pool_lab"
    }
  ],
  "edges": [
    {
      "id": "flow_start_consult",
      "source": "start_consultation",
      "target": "task_consult_physician",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_consult_prescribe",
      "source": "task_consult_physician",
      "target": "task_prescribe_blood_test",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_prescribe_lab",
      "source": "task_prescribe_blood_test",
      "target": "task_lab_analysis",
      "type": "messageFlow"
    },
    {
      "id": "flow_lab_gateway",
      "source": "task_lab_analysis",
      "target": "gateway_analysis_results",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_gateway_anormal",
      "source": "gateway_analysis_results",
      "target": "intermediate_catch_anormal_results",
      "type": "sequenceFlow",
      "name": "Résultats anormaux"
    },
    {
      "id": "flow_anormal_examine",
      "source": "intermediate_catch_anormal_results",
      "target": "task_examine_patient",
      "type": "messageFlow"
    },
    {
      "id": "flow_examine_end",
      "source": "task_examine_patient",
      "target": "end_consultation_specialist",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_gateway_normal",
      "source": "gateway_analysis_results",
      "target": "intermediate_catch_normal_results",
      "type": "sequenceFlow",
      "name": "Résultats normaux"
    },
    {
      "id": "flow_normal_inform",
      "source": "intermediate_catch_normal_results",
      "target": "task_inform_normal",
      "type": "messageFlow"
    },
    {
      "id": "flow_inform_end",
      "source": "task_inform_normal",
      "target": "end_consultation_normal",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_1",
      "source": "start_pool_lab",
      "target": "task_lab_analysis",
      "type": "sequenceFlow"
    }
  ]
}