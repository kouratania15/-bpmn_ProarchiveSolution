{
  "process": {
    "id": "process_quality_control",
    "name": "Processus de contrôle qualité en parallèle",
    "documentation": "Processus de contrôle qualité sur un lot de production avec trois contrôles parallèles et arrêt immédiat en cas de défaut critique détecté lors du test de résistance."
  },
  "pools": [
    {
      "id": "pool_usine",
      "name": "Usine",
      "lanes": []
    }
  ],
  "nodes": [
    {
      "id": "start_event",
      "type": "startEvent",
      "name": "Début du processus de contrôle qualité",
      "eventDefinition": "none",
      "poolId": "pool_usine"
    },
    {
      "id": "task_visual_inspection",
      "type": "task",
      "name": "Contrôle visuel",
      "poolId": "pool_usine"
    },
    {
      "id": "task_dimension_check",
      "type": "task",
      "name": "Contrôle dimensionnel",
      "poolId": "pool_usine"
    },
    {
      "id": "task_strength_test",
      "type": "task",
      "name": "Test de résistance",
      "poolId": "pool_usine"
    },
    {
      "id": "boundary_event_critical_defect",
      "type": "boundaryEvent",
      "name": "Détection d'un défaut critique",
      "attachedToRef": "task_strength_test",
      "eventDefinition": "error",
      "eventDetail": "Défaut critique détecté",
      "cancelActivity": true,
      "poolId": "pool_usine"
    },
    {
      "id": "task_stop_process",
      "type": "task",
      "name": "Arrêt du processus",
      "poolId": "pool_usine",
      "documentation": "GAP: connexion automatique de secours — rattaché automatiquement au flux principal depuis 'parallel_gateway_join' ; cohérence métier non garantie, à vérifier."
    },
    {
      "id": "task_validate_batch",
      "type": "task",
      "name": "Validation du lot pour expédition",
      "poolId": "pool_usine"
    },
    {
      "id": "end_event_no_critical_defect",
      "type": "endEvent",
      "name": "Lot validé pour expédition",
      "eventDefinition": "none",
      "poolId": "pool_usine",
      "documentation": "GAP: connexion automatique de secours — reçoit une transition de secours depuis 'task_stop_process' ; cohérence métier non garantie, à vérifier."
    },
    {
      "id": "end_event_critical_defect",
      "type": "endEvent",
      "name": "Processus arrêté en raison d'un défaut critique",
      "eventDefinition": "none",
      "poolId": "pool_usine"
    },
    {
      "id": "parallel_gateway_start",
      "type": "parallelGateway",
      "name": "Lancement des contrôles parallèles",
      "gatewayDirection": "diverging",
      "poolId": "pool_usine"
    },
    {
      "id": "parallel_gateway_join",
      "type": "parallelGateway",
      "name": "Validation des contrôles",
      "gatewayDirection": "converging",
      "poolId": "pool_usine"
    }
  ],
  "edges": [
    {
      "id": "flow_start_to_parallel_gateway_start",
      "source": "start_event",
      "target": "parallel_gateway_start",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_parallel_gateway_start_to_visual_inspection",
      "source": "parallel_gateway_start",
      "target": "task_visual_inspection",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_parallel_gateway_start_to_dimension_check",
      "source": "parallel_gateway_start",
      "target": "task_dimension_check",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_parallel_gateway_start_to_strength_test",
      "source": "parallel_gateway_start",
      "target": "task_strength_test",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_visual_inspection_to_parallel_gateway_join",
      "source": "task_visual_inspection",
      "target": "parallel_gateway_join",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_dimension_check_to_parallel_gateway_join",
      "source": "task_dimension_check",
      "target": "parallel_gateway_join",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_strength_test_to_parallel_gateway_join",
      "source": "task_strength_test",
      "target": "parallel_gateway_join",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_critical_defect_to_end_event_critical_defect",
      "source": "boundary_event_critical_defect",
      "target": "end_event_critical_defect",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_parallel_gateway_join_to_validate_batch",
      "source": "parallel_gateway_join",
      "target": "task_validate_batch",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_validate_batch_to_end_event_no_critical_defect",
      "source": "task_validate_batch",
      "target": "end_event_no_critical_defect",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_1",
      "source": "parallel_gateway_join",
      "target": "task_stop_process",
      "type": "sequenceFlow"
    },
    {
      "id": "flow_2",
      "source": "task_stop_process",
      "target": "end_event_no_critical_defect",
      "type": "sequenceFlow"
    }
  ]
}