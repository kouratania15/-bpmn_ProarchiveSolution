<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_register_supplier"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_process_register_supplier">
    <bpmn:participant id="pool_company" name="Entreprise" processRef="process_register_supplier" />
  </bpmn:collaboration>
  <bpmn:process id="process_register_supplier" name="Entreprise" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_supplier" name="Fournisseur">
        <bpmn:flowNodeRef>task_submit_data</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_manager" name="Gestionnaire">
        <bpmn:flowNodeRef>task_check_registration</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_event" name="Début du processus d&#x27;enregistrement">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_company&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_to_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_submit_data" name="Soumet ses données d&#x27;enregistrement">
      <bpmn:incoming>flow_start_to_submit</bpmn:incoming>
      <bpmn:outgoing>flow_submit_to_check</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="data_store_supplier_db" name="Base de données des fournisseurs" />
    <bpmn:task id="task_check_registration" name="Vérifie si le fournisseur est déjà enregistré">
      <bpmn:incoming>flow_submit_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_event" name="Fin du processus de vérification">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_company&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_check_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_to_submit" name="" sourceRef="start_event" targetRef="task_submit_data">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_submit_to_check" name="" sourceRef="task_submit_data" targetRef="task_check_registration">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_check_to_end" name="" sourceRef="task_check_registration" targetRef="end_event">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_register_supplier">
      <bpmndi:BPMNShape id="pool_company_di" bpmnElement="pool_company" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="900" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_supplier_di" bpmnElement="lane_supplier" isHorizontal="true">
        <dc:Bounds x="90" y="50" width="870" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_manager_di" bpmnElement="lane_manager" isHorizontal="true">
        <dc:Bounds x="90" y="240" width="870" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_di" bpmnElement="start_event">
        <dc:Bounds x="120" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_data_di" bpmnElement="task_submit_data">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_store_supplier_db_di" bpmnElement="data_store_supplier_db">
        <dc:Bounds x="60" y="20" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_registration_di" bpmnElement="task_check_registration">
        <dc:Bounds x="440" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_di" bpmnElement="end_event">
        <dc:Bounds x="600" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_submit_di" bpmnElement="flow_start_to_submit">
        <di:waypoint x="156" y="98" />
        <di:waypoint x="218" y="98" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_submit_to_check_di" bpmnElement="flow_submit_to_check">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="320" />
        <di:waypoint x="440" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_to_end_di" bpmnElement="flow_check_to_end">
        <di:waypoint x="540" y="320" />
        <di:waypoint x="570" y="320" />
        <di:waypoint x="570" y="98" />
        <di:waypoint x="600" y="98" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>