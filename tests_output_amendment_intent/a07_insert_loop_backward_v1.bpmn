<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_publishing"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_submit_to_review" name="flow_submit_to_review" />
  <bpmn:collaboration id="Collaboration_process_publishing">
    <bpmn:participant id="author_pool" name="Auteur" processRef="author_pool_process" />
    <bpmn:participant id="editor_pool" name="Éditeur" processRef="editor_pool_process" />
    <bpmn:messageFlow id="flow_submit_to_review" name="" sourceRef="task_submit_article" targetRef="task_editor_review" messageRef="Message_flow_submit_to_review" />
  </bpmn:collaboration>
  <bpmn:process id="author_pool_process" name="Auteur" isExecutable="true">
    <bpmn:startEvent id="start_event_submission" name="Soumission de l&#x27;article">
      <bpmn:documentation>Déclenchement du processus par la soumission de l&#x27;article par l&#x27;auteur. GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;author_pool&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_to_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_submit_article" name="Soumet un article">
      <bpmn:documentation>L&#x27;auteur soumet un article pour publication.</bpmn:documentation>
      <bpmn:incoming>flow_start_to_submit</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_start_to_submit" name="" sourceRef="start_event_submission" targetRef="task_submit_article">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="editor_pool_process" name="Éditeur" isExecutable="true">
    <bpmn:task id="task_editor_review" name="Relit l&#x27;article">
      <bpmn:documentation>L&#x27;éditeur relit l&#x27;article soumis par l&#x27;auteur. GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;editor_pool&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_review_to_publish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_publish_article" name="Publie l&#x27;article">
      <bpmn:documentation>L&#x27;éditeur publie l&#x27;article après relecture.</bpmn:documentation>
      <bpmn:incoming>flow_review_to_publish</bpmn:incoming>
      <bpmn:outgoing>flow_publish_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_event_published" name="Article publié">
      <bpmn:documentation>Fin du processus après publication de l&#x27;article. GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;editor_pool&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_publish_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="start_editor_pool" name="Start Éditeur">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_review_to_publish" name="" sourceRef="task_editor_review" targetRef="task_publish_article">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_publish_to_end" name="" sourceRef="task_publish_article" targetRef="end_event_published">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_1" name="" sourceRef="start_editor_pool" targetRef="task_editor_review">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_publishing">
      <bpmndi:BPMNShape id="author_pool_di" bpmnElement="author_pool" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="480" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="editor_pool_di" bpmnElement="editor_pool" isHorizontal="true">
        <dc:Bounds x="60" y="280" width="736" height="366" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_submission_di" bpmnElement="start_event_submission">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_article_di" bpmnElement="task_submit_article">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_editor_review_di" bpmnElement="task_editor_review">
        <dc:Bounds x="280" y="496" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_publish_article_di" bpmnElement="task_publish_article">
        <dc:Bounds x="440" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_published_di" bpmnElement="end_event_published">
        <dc:Bounds x="600" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_editor_pool_di" bpmnElement="start_editor_pool">
        <dc:Bounds x="120" y="430" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_submit_di" bpmnElement="flow_start_to_submit">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_review_to_publish_di" bpmnElement="flow_review_to_publish">
        <di:waypoint x="380" y="536" />
        <di:waypoint x="410" y="536" />
        <di:waypoint x="410" y="360" />
        <di:waypoint x="440" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_publish_to_end_di" bpmnElement="flow_publish_to_end">
        <di:waypoint x="540" y="360" />
        <di:waypoint x="570" y="360" />
        <di:waypoint x="570" y="338" />
        <di:waypoint x="600" y="338" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="156" y="448" />
        <di:waypoint x="218" y="448" />
        <di:waypoint x="218" y="536" />
        <di:waypoint x="280" y="536" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_submit_to_review_di" bpmnElement="flow_submit_to_review">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="596" />
        <di:waypoint x="250" y="596" />
        <di:waypoint x="250" y="536" />
        <di:waypoint x="280" y="536" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>