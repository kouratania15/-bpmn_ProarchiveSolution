      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_vote_membre3_di" bpmnElement="task_vote_membre3">
        <dc:Bounds x="600" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_vote_membre4_di" bpmnElement="task_vote_membre4">
        <dc:Bounds x="760" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_vote_membre5_di" bpmnElement="task_vote_membre5">
        <dc:Bounds x="920" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_decision_complexe_di" bpmnElement="gateway_decision_complexe">
        <dc:Bounds x="1080" y="90" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_approbation_di" bpmnElement="task_approbation">
        <dc:Bounds x="1240" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_notification_demandeur_di" bpmnElement="task_notification_demandeur">
        <dc:Bounds x="1400" y="496" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_approve_di" bpmnElement="end_event_approve">
        <dc:Bounds x="1560" y="496" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_reject_di" bpmnElement="end_event_reject">
        <dc:Bounds x="1240" y="266" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_pool_comite_di" bpmnElement="start_pool_comite">
        <dc:Bounds x="120" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
