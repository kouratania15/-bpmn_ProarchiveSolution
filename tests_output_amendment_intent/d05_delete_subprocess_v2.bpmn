<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_reclamation"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_soumet_traiter" name="flow_soumet_traiter" />
  <bpmn:collaboration id="Collaboration_process_reclamation">
    <bpmn:participant id="pool_client" name="Client" processRef="pool_client_process" />
    <bpmn:participant id="pool_entreprise" name="Entreprise" processRef="pool_entreprise_process" />
    <bpmn:messageFlow id="flow_soumet_traiter" name="" sourceRef="task_soumet_reclamation" targetRef="task_traiter_reclamation" messageRef="Message_flow_soumet_traiter" />
  </bpmn:collaboration>
  <bpmn:process id="pool_client_process" name="Client" isExecutable="true">
    <bpmn:startEvent id="start_reclamation" name="Réclamation soumise">
      <bpmn:outgoing>flow_start_reclamation</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_soumet_reclamation" name="Soumettre une réclamation">
      <bpmn:incoming>flow_start_reclamation</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_start_reclamation" name="" sourceRef="start_reclamation" targetRef="task_soumet_reclamation">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_entreprise_process" name="Entreprise" isExecutable="true">
    <bpmn:task id="task_traiter_reclamation" name="Transmettre la réclamation au service juridique">
      <bpmn:documentation>Transmission directe au service juridique sans évaluation préalable.</bpmn:documentation>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_end_reclamation</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_reclamation_traitement" name="Réclamation transmise au service juridique">
      <bpmn:incoming>flow_end_reclamation</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="start_pool_entreprise" name="Start Entreprise">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_end_reclamation" name="" sourceRef="task_traiter_reclamation" targetRef="end_reclamation_traitement">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_1" name="" sourceRef="start_pool_entreprise" targetRef="task_traiter_reclamation">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_reclamation">
      <bpmndi:BPMNShape id="pool_client_di" bpmnElement="pool_client" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="480" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_entreprise_di" bpmnElement="pool_entreprise" isHorizontal="true">
        <dc:Bounds x="60" y="280" width="576" height="322" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_reclamation_di" bpmnElement="start_reclamation">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_soumet_reclamation_di" bpmnElement="task_soumet_reclamation">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_traiter_reclamation_di" bpmnElement="task_traiter_reclamation">
        <dc:Bounds x="280" y="452" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_reclamation_traitement_di" bpmnElement="end_reclamation_traitement">
        <dc:Bounds x="440" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_pool_entreprise_di" bpmnElement="start_pool_entreprise">
        <dc:Bounds x="120" y="386" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_reclamation_di" bpmnElement="flow_start_reclamation">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_end_reclamation_di" bpmnElement="flow_end_reclamation">
        <di:waypoint x="380" y="492" />
        <di:waypoint x="410" y="492" />
        <di:waypoint x="410" y="338" />
        <di:waypoint x="440" y="338" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="156" y="404" />
        <di:waypoint x="218" y="404" />
        <di:waypoint x="218" y="492" />
        <di:waypoint x="280" y="492" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_soumet_traiter_di" bpmnElement="flow_soumet_traiter">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="552" />
        <di:waypoint x="250" y="552" />
        <di:waypoint x="250" y="492" />
        <di:waypoint x="280" y="492" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>