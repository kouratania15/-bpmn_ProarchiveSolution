<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_evaluation"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_process_evaluation">
    <bpmn:participant id="pool_comite" name="Comité d&#x27;évaluation" processRef="process_evaluation" />
  </bpmn:collaboration>
  <bpmn:process id="process_evaluation" name="Comité d&#x27;évaluation" isExecutable="true">
    <bpmn:startEvent id="start_event" name="Début du processus d&#x27;évaluation">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_comite&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_to_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_submit_project" name="Projet soumis pour évaluation">
      <bpmn:incoming>flow_start_to_submit</bpmn:incoming>
      <bpmn:outgoing>flow_submit_to_evaluate</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_evaluate_project" name="Évaluation du projet par le comité">
      <bpmn:incoming>flow_evaluate_to_join</bpmn:incoming>
      <bpmn:outgoing>flow_evaluate_to_join_end</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopDataInputRef>data_comite_membres</bpmn:loopDataInputRef>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:task>
    <bpmn:dataObject id="data_comite_membres_obj" isCollection="true" />
    <bpmn:dataObjectReference id="data_comite_membres" name="Liste des membres du comité" dataObjectRef="data_comite_membres_obj" />
    <bpmn:parallelGateway id="parallel_gateway_evaluation" name="Démarrage des évaluations parallèles">
      <bpmn:incoming>flow_submit_to_evaluate</bpmn:incoming>
      <bpmn:outgoing>flow_evaluate_to_join</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="end_event" name="Évaluation terminée">
      <bpmn:documentation>Fin du processus d&#x27;évaluation GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_comite&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_join_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="parallel_gateway_join" name="Convergence des évaluations">
      <bpmn:incoming>flow_evaluate_to_join_end</bpmn:incoming>
      <bpmn:outgoing>flow_join_to_end</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="flow_start_to_submit" name="" sourceRef="start_event" targetRef="task_submit_project">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_submit_to_evaluate" name="" sourceRef="task_submit_project" targetRef="parallel_gateway_evaluation">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_evaluate_to_join" name="" sourceRef="parallel_gateway_evaluation" targetRef="task_evaluate_project">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_evaluate_to_join_end" name="" sourceRef="task_evaluate_project" targetRef="parallel_gateway_join">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_join_to_end" name="" sourceRef="parallel_gateway_join" targetRef="end_event">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_evaluation">
      <bpmndi:BPMNShape id="pool_comite_di" bpmnElement="pool_comite" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="1056" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_di" bpmnElement="start_event">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_project_di" bpmnElement="task_submit_project">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_evaluate_project_di" bpmnElement="task_evaluate_project">
        <dc:Bounds x="600" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="data_comite_membres_di" bpmnElement="data_comite_membres">
        <dc:Bounds x="60" y="20" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="parallel_gateway_evaluation_di" bpmnElement="parallel_gateway_evaluation">
        <dc:Bounds x="440" y="90" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_di" bpmnElement="end_event">
        <dc:Bounds x="920" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="parallel_gateway_join_di" bpmnElement="parallel_gateway_join">
        <dc:Bounds x="760" y="90" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_submit_di" bpmnElement="flow_start_to_submit">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_submit_to_evaluate_di" bpmnElement="flow_submit_to_evaluate">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="115" />
        <di:waypoint x="440" y="115" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_evaluate_to_join_di" bpmnElement="flow_evaluate_to_join">
        <di:waypoint x="490" y="115" />
        <di:waypoint x="545" y="115" />
        <di:waypoint x="545" y="130" />
        <di:waypoint x="600" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_evaluate_to_join_end_di" bpmnElement="flow_evaluate_to_join_end">
        <di:waypoint x="700" y="130" />
        <di:waypoint x="730" y="130" />
        <di:waypoint x="730" y="115" />
        <di:waypoint x="760" y="115" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_join_to_end_di" bpmnElement="flow_join_to_end">
        <di:waypoint x="810" y="115" />
        <di:waypoint x="865" y="115" />
        <di:waypoint x="865" y="108" />
        <di:waypoint x="920" y="108" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>