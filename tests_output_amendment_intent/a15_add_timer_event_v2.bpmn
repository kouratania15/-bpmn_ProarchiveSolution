<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_support_ticket"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_process_support_ticket">
    <bpmn:participant id="pool_support" name="Service Support" processRef="process_support_ticket" />
  </bpmn:collaboration>
  <bpmn:process id="process_support_ticket" name="Service Support" isExecutable="true">
    <bpmn:startEvent id="start_ticket_submitted" name="Ticket soumis">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_support&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_to_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_submit_ticket" name="Soumet un ticket de support">
      <bpmn:incoming>flow_start_to_submit</bpmn:incoming>
      <bpmn:outgoing>flow_submit_to_reply</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_reply_ticket" name="Répond au ticket">
      <bpmn:incoming>flow_gateway_to_reply</bpmn:incoming>
      <bpmn:outgoing>flow_reply_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_reply_timeout" name="Réponse dans les 24h ?">
      <bpmn:incoming>flow_submit_to_reply</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_to_reply</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_to_transfer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="task_transfer_to_responsible" name="Transfère au responsable">
      <bpmn:incoming>flow_gateway_to_transfer</bpmn:incoming>
      <bpmn:incoming>flow_reply_to_timer</bpmn:incoming>
      <bpmn:outgoing>flow_transfer_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_ticket_resolved" name="Ticket résolu">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_support&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_reply_to_end</bpmn:incoming>
      <bpmn:incoming>flow_transfer_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="timer_24h" name="Délai de réponse dépassé (24h)" attachedToRef="task_reply_ticket" cancelActivity="true">
      <bpmn:outgoing>flow_reply_to_timer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timer_24h_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_start_to_submit" name="" sourceRef="start_ticket_submitted" targetRef="task_submit_ticket">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_submit_to_reply" name="" sourceRef="task_submit_ticket" targetRef="gateway_reply_timeout">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_reply_to_end" name="" sourceRef="task_reply_ticket" targetRef="end_ticket_resolved">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_to_reply" name="Réponse envoyée" sourceRef="gateway_reply_timeout" targetRef="task_reply_ticket">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_to_transfer" name="Délai dépassé" sourceRef="gateway_reply_timeout" targetRef="task_transfer_to_responsible">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_transfer_to_end" name="" sourceRef="task_transfer_to_responsible" targetRef="end_ticket_resolved">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_reply_to_timer" name="" sourceRef="timer_24h" targetRef="task_transfer_to_responsible">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_support_ticket">
      <bpmndi:BPMNShape id="pool_support_di" bpmnElement="pool_support" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="896" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_ticket_submitted_di" bpmnElement="start_ticket_submitted">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_ticket_di" bpmnElement="task_submit_ticket">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_reply_ticket_di" bpmnElement="task_reply_ticket">
        <dc:Bounds x="600" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_reply_timeout_di" bpmnElement="gateway_reply_timeout">
        <dc:Bounds x="440" y="90" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_transfer_to_responsible_di" bpmnElement="task_transfer_to_responsible">
        <dc:Bounds x="600" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_ticket_resolved_di" bpmnElement="end_ticket_resolved">
        <dc:Bounds x="760" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="timer_24h_di" bpmnElement="timer_24h">
        <dc:Bounds x="682" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_submit_di" bpmnElement="flow_start_to_submit">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_submit_to_reply_di" bpmnElement="flow_submit_to_reply">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="115" />
        <di:waypoint x="440" y="115" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reply_to_end_di" bpmnElement="flow_reply_to_end">
        <di:waypoint x="700" y="130" />
        <di:waypoint x="730" y="130" />
        <di:waypoint x="730" y="108" />
        <di:waypoint x="760" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_to_reply_di" bpmnElement="flow_gateway_to_reply">
        <di:waypoint x="490" y="115" />
        <di:waypoint x="545" y="115" />
        <di:waypoint x="545" y="130" />
        <di:waypoint x="600" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="110" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_to_transfer_di" bpmnElement="flow_gateway_to_transfer">
        <di:waypoint x="490" y="115" />
        <di:waypoint x="545" y="115" />
        <di:waypoint x="545" y="240" />
        <di:waypoint x="600" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="220" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_transfer_to_end_di" bpmnElement="flow_transfer_to_end">
        <di:waypoint x="700" y="240" />
        <di:waypoint x="730" y="240" />
        <di:waypoint x="730" y="108" />
        <di:waypoint x="760" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reply_to_timer_di" bpmnElement="flow_reply_to_timer">
        <di:waypoint x="700" y="188" />
        <di:waypoint x="730" y="188" />
        <di:waypoint x="730" y="300" />
        <di:waypoint x="570" y="300" />
        <di:waypoint x="570" y="240" />
        <di:waypoint x="600" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>