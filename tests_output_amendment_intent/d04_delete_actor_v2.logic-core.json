      "laneId": "lane_reception",
      "poolId": "pool_hotel",
      "sourceProcessElement": "activity_3"
    },
    {
      "id": "end_reservation_finalisee",
      "name": "Réservation finalisée et chambre prête",
      "type": "endEvent",
