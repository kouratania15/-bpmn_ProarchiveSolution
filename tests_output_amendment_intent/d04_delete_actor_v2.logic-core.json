    },
    {
      "id": "flow_preparer_finaliser",
      "name": "Chambre prête",
      "type": "sequenceFlow",
      "source": "task_preparer_chambre",
      "target": "end_reservation_finalisee",
      "sourceProcessElement": "relation_004"
    },
    {
      "id": "flow_1",
      "type": "sequenceFlow",
      "source": "start_pool_hotel",
      "target": "task_confirmer_reservation"
