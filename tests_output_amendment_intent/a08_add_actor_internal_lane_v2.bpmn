<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_reservation_chambre"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_reserver_confirmer" name="Demande de confirmation" />
  <bpmn:collaboration id="Collaboration_process_reservation_chambre">
    <bpmn:participant id="pool_client" name="Client" processRef="pool_client_process" />
    <bpmn:participant id="pool_reception" name="Réception" processRef="pool_reception_process" />
    <bpmn:messageFlow id="flow_reserver_confirmer" name="Demande de confirmation" sourceRef="task_reserver_chambre" targetRef="task_confirmer_reservation" messageRef="Message_flow_reserver_confirmer" />
  </bpmn:collaboration>
  <bpmn:process id="pool_client_process" name="Client" isExecutable="true">
    <bpmn:startEvent id="start_reservation" name="Demande de réservation">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_client&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_reservation</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="task_reserver_chambre" name="Réserver une chambre">
      <bpmn:incoming>flow_start_reservation</bpmn:incoming>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="flow_start_reservation" name="" sourceRef="start_reservation" targetRef="task_reserver_chambre">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_reception_process" name="Réception" isExecutable="true">
    <bpmn:manualTask id="task_confirmer_reservation" name="Confirmer la réservation">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_reception&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_confirmer_preparer</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="end_reservation_confirme" name="Réservation confirmée">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_reception&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_preparer_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_preparer_chambre" name="Préparer la chambre">
      <bpmn:incoming>flow_confirmer_preparer</bpmn:incoming>
      <bpmn:outgoing>flow_preparer_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="start_pool_reception" name="Start Réception">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_confirmer_preparer" name="" sourceRef="task_confirmer_reservation" targetRef="task_preparer_chambre">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_preparer_end" name="" sourceRef="task_preparer_chambre" targetRef="end_reservation_confirme">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_1" name="" sourceRef="start_pool_reception" targetRef="task_confirmer_reservation">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_reservation_chambre">
      <bpmndi:BPMNShape id="pool_client_di" bpmnElement="pool_client" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="480" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_reception_di" bpmnElement="pool_reception" isHorizontal="true">
        <dc:Bounds x="60" y="280" width="736" height="366" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_reservation_di" bpmnElement="start_reservation">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_reserver_chambre_di" bpmnElement="task_reserver_chambre">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_confirmer_reservation_di" bpmnElement="task_confirmer_reservation">
        <dc:Bounds x="280" y="496" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_reservation_confirme_di" bpmnElement="end_reservation_confirme">
        <dc:Bounds x="600" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_preparer_chambre_di" bpmnElement="task_preparer_chambre">
        <dc:Bounds x="440" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_pool_reception_di" bpmnElement="start_pool_reception">
        <dc:Bounds x="120" y="430" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_reservation_di" bpmnElement="flow_start_reservation">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_confirmer_preparer_di" bpmnElement="flow_confirmer_preparer">
        <di:waypoint x="380" y="536" />
        <di:waypoint x="410" y="536" />
        <di:waypoint x="410" y="360" />
        <di:waypoint x="440" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_preparer_end_di" bpmnElement="flow_preparer_end">
        <di:waypoint x="540" y="360" />
        <di:waypoint x="570" y="360" />
        <di:waypoint x="570" y="338" />
        <di:waypoint x="600" y="338" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="156" y="448" />
        <di:waypoint x="218" y="448" />
        <di:waypoint x="218" y="536" />
        <di:waypoint x="280" y="536" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_reserver_confirmer_di" bpmnElement="flow_reserver_confirmer">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="596" />
        <di:waypoint x="250" y="596" />
        <di:waypoint x="250" y="536" />
        <di:waypoint x="280" y="536" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="230" y="576" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>