      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_ventes_di" bpmnElement="pool_ventes" isHorizontal="true">
        <dc:Bounds x="60" y="784" width="416" height="212" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_di" bpmnElement="start_event">
