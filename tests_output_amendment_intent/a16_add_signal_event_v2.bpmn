      <bpmndi:BPMNShape id="event_throw_signal_di" bpmnElement="event_throw_signal">
        <dc:Bounds x="440" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_catch_signal_production_di" bpmnElement="event_catch_signal_production">
        <dc:Bounds x="280" y="386" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_catch_signal_logistique_di" bpmnElement="event_catch_signal_logistique">
        <dc:Bounds x="280" y="638" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="event_catch_signal_ventes_di" bpmnElement="event_catch_signal_ventes">
        <dc:Bounds x="280" y="890" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_di" bpmnElement="end_event">
        <dc:Bounds x="440" y="320" width="36" height="36" />
