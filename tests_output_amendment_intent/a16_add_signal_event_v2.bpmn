<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_quality_service"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_signal_production" name="flow_signal_production" />
  <bpmn:message id="Message_flow_signal_logistique" name="flow_signal_logistique" />
  <bpmn:message id="Message_flow_signal_ventes" name="flow_signal_ventes" />
  <bpmn:message id="Message_flow_logistique_end" name="flow_logistique_end" />
  <bpmn:message id="Message_flow_ventes_end" name="flow_ventes_end" />
  <bpmn:collaboration id="Collaboration_process_quality_service">
    <bpmn:participant id="pool_service_qualite" name="Service Qualité" processRef="pool_service_qualite_process" />
    <bpmn:participant id="pool_production" name="Production" processRef="pool_production_process" />
    <bpmn:participant id="pool_logistique" name="Logistique" processRef="pool_logistique_process" />
    <bpmn:participant id="pool_ventes" name="Ventes" processRef="pool_ventes_process" />
    <bpmn:messageFlow id="flow_signal_production" name="" sourceRef="event_throw_signal" targetRef="event_catch_signal_production" messageRef="Message_flow_signal_production" />
    <bpmn:messageFlow id="flow_signal_logistique" name="" sourceRef="event_throw_signal" targetRef="event_catch_signal_logistique" messageRef="Message_flow_signal_logistique" />
    <bpmn:messageFlow id="flow_signal_ventes" name="" sourceRef="event_throw_signal" targetRef="event_catch_signal_ventes" messageRef="Message_flow_signal_ventes" />
    <bpmn:messageFlow id="flow_logistique_end" name="" sourceRef="event_catch_signal_logistique" targetRef="end_event" messageRef="Message_flow_logistique_end" />
    <bpmn:messageFlow id="flow_ventes_end" name="" sourceRef="event_catch_signal_ventes" targetRef="end_event" messageRef="Message_flow_ventes_end" />
  </bpmn:collaboration>
  <bpmn:process id="pool_service_qualite_process" name="Service Qualité" isExecutable="true">
    <bpmn:startEvent id="start_event" name="Détection d&#x27;un défaut qualité">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_service_qualite&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_task</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_diffuser_alarme" name="Diffuser une alerte aux services concernés">
      <bpmn:incoming>flow_start_task</bpmn:incoming>
      <bpmn:outgoing>flow_task_event_throw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="event_throw_signal" name="Diffusion d&#x27;alerte qualité">
      <bpmn:incoming>flow_task_event_throw</bpmn:incoming>
      <bpmn:signalEventDefinition id="event_throw_signal_def">
      </bpmn:signalEventDefinition>
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="flow_start_task" name="" sourceRef="start_event" targetRef="task_diffuser_alarme">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_task_event_throw" name="" sourceRef="task_diffuser_alarme" targetRef="event_throw_signal">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_production_process" name="Production" isExecutable="true">
    <bpmn:intermediateCatchEvent id="event_catch_signal_production" name="Réception de l&#x27;alerte qualité">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_production&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_production_end</bpmn:outgoing>
      <bpmn:signalEventDefinition id="event_catch_signal_production_def">
      </bpmn:signalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="end_event" name="Traitement des alertes terminé">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_production&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_production_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="start_pool_production" name="Start Production">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_production_end" name="" sourceRef="event_catch_signal_production" targetRef="end_event">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_1" name="" sourceRef="start_pool_production" targetRef="event_catch_signal_production">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_logistique_process" name="Logistique" isExecutable="true">
    <bpmn:intermediateCatchEvent id="event_catch_signal_logistique" name="Réception de l&#x27;alerte qualité">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_logistique&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:signalEventDefinition id="event_catch_signal_logistique_def">
      </bpmn:signalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="start_pool_logistique" name="Start Logistique">
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_2" name="" sourceRef="start_pool_logistique" targetRef="event_catch_signal_logistique">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_ventes_process" name="Ventes" isExecutable="true">
    <bpmn:intermediateCatchEvent id="event_catch_signal_ventes" name="Réception de l&#x27;alerte qualité">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_ventes&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:signalEventDefinition id="event_catch_signal_ventes_def">
      </bpmn:signalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="start_pool_ventes" name="Start Ventes">
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_3" name="" sourceRef="start_pool_ventes" targetRef="event_catch_signal_ventes">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_quality_service">
      <bpmndi:BPMNShape id="pool_service_qualite_di" bpmnElement="pool_service_qualite" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="576" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_production_di" bpmnElement="pool_production" isHorizontal="true">
        <dc:Bounds x="60" y="280" width="576" height="212" />
