      <bpmndi:BPMNShape id="start_pool_production_di" bpmnElement="start_pool_production">
        <dc:Bounds x="120" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_pool_logistique_di" bpmnElement="start_pool_logistique">
        <dc:Bounds x="120" y="572" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_pool_ventes_di" bpmnElement="start_pool_ventes">
        <dc:Bounds x="120" y="824" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_task_di" bpmnElement="flow_start_task">
