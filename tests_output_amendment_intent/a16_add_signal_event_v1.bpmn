<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_quality_service"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_process_quality_service">
    <bpmn:participant id="pool_service_qualite" name="Service Qualité" processRef="process_quality_service" />
  </bpmn:collaboration>
  <bpmn:process id="process_quality_service" name="Service Qualité" isExecutable="true">
    <bpmn:startEvent id="start_detect_defect" name="Détection d&#x27;un défaut sur un lot de production">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_service_qualite&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_detect</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_detect_defect" name="Détecter un défaut sur un lot de production">
      <bpmn:incoming>flow_start_detect</bpmn:incoming>
      <bpmn:outgoing>flow_detect_correct</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_correct_defect" name="Corriger le défaut">
      <bpmn:incoming>flow_detect_correct</bpmn:incoming>
      <bpmn:outgoing>flow_correct_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_process_completed" name="Processus de correction terminé">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_service_qualite&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_correct_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_detect" name="" sourceRef="start_detect_defect" targetRef="task_detect_defect">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_detect_correct" name="" sourceRef="task_detect_defect" targetRef="task_correct_defect">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_correct_end" name="" sourceRef="task_correct_defect" targetRef="end_process_completed">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_quality_service">
      <bpmndi:BPMNShape id="pool_service_qualite_di" bpmnElement="pool_service_qualite" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="736" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_detect_defect_di" bpmnElement="start_detect_defect">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_detect_defect_di" bpmnElement="task_detect_defect">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_correct_defect_di" bpmnElement="task_correct_defect">
        <dc:Bounds x="440" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_process_completed_di" bpmnElement="end_process_completed">
        <dc:Bounds x="600" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_detect_di" bpmnElement="flow_start_detect">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_detect_correct_di" bpmnElement="flow_detect_correct">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="440" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_correct_end_di" bpmnElement="flow_correct_end">
        <di:waypoint x="540" y="130" />
        <di:waypoint x="570" y="130" />
        <di:waypoint x="570" y="108" />
        <di:waypoint x="600" y="108" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>