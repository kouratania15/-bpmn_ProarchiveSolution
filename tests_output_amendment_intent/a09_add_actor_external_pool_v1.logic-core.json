      "sourceProcessElement": "event_1"
    },
    {
      "id": "task_client_place_order",
      "type": "task",
      "name": "Passe une commande de meubles",
      "poolId": "pool_client",
      "sourceProcessElement": "activity_1"
    },
    {
      "id": "task_magasin_prepare_order",
      "type": "task",
      "name": "Prépare la commande",
      "poolId": "pool_magasin",
