<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_livraison_colis"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_process_livraison_colis">
    <bpmn:participant id="pool_transporteur" name="Transporteur" processRef="process_livraison_colis" />
  </bpmn:collaboration>
  <bpmn:process id="process_livraison_colis" name="Transporteur" isExecutable="true">
    <bpmn:startEvent id="start_livraison" name="Début de la livraison du colis">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_transporteur&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_colis</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_colis_en_cours" name="Colis en cours de livraison">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_transporteur&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_start_colis</bpmn:incoming>
      <bpmn:outgoing>flow_colis_livraison</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_livraison_transporteur" name="Livraison du colis par le transporteur">
      <bpmn:incoming>flow_colis_livraison</bpmn:incoming>
      <bpmn:outgoing>flow_livraison_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_livraison_terminee" name="Livraison du colis terminée">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_transporteur&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_livraison_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_colis" name="" sourceRef="start_livraison" targetRef="task_colis_en_cours">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_colis_livraison" name="" sourceRef="task_colis_en_cours" targetRef="task_livraison_transporteur">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_livraison_end" name="" sourceRef="task_livraison_transporteur" targetRef="end_livraison_terminee">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_livraison_colis">
      <bpmndi:BPMNShape id="pool_transporteur_di" bpmnElement="pool_transporteur" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="736" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_livraison_di" bpmnElement="start_livraison">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_colis_en_cours_di" bpmnElement="task_colis_en_cours">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_livraison_transporteur_di" bpmnElement="task_livraison_transporteur">
        <dc:Bounds x="440" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_livraison_terminee_di" bpmnElement="end_livraison_terminee">
        <dc:Bounds x="600" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_colis_di" bpmnElement="flow_start_colis">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_colis_livraison_di" bpmnElement="flow_colis_livraison">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="440" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_livraison_end_di" bpmnElement="flow_livraison_end">
        <di:waypoint x="540" y="130" />
        <di:waypoint x="570" y="130" />
        <di:waypoint x="570" y="108" />
        <di:waypoint x="600" y="108" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>