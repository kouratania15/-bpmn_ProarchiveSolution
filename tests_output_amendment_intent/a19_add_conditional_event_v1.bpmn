<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_evaluation_offres"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_submit_evaluate" name="flow_submit_evaluate" />
  <bpmn:collaboration id="Collaboration_process_evaluation_offres">
    <bpmn:participant id="pool_fournisseur" name="Fournisseur" processRef="pool_fournisseur_process" />
    <bpmn:participant id="pool_acheteur" name="Acheteur" processRef="pool_acheteur_process" />
    <bpmn:messageFlow id="flow_submit_evaluate" name="" sourceRef="task_submit_offer" targetRef="task_evaluate_offer" messageRef="Message_flow_submit_evaluate" />
  </bpmn:collaboration>
  <bpmn:process id="pool_fournisseur_process" name="Fournisseur" isExecutable="true">
    <bpmn:startEvent id="start_evaluation" name="Début du processus d&#x27;évaluation des offres">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_fournisseur&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_submit_offer" name="Soumet une offre">
      <bpmn:incoming>flow_start_submit</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_start_submit" name="" sourceRef="start_evaluation" targetRef="task_submit_offer">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_acheteur_process" name="Acheteur" isExecutable="true">
    <bpmn:task id="task_evaluate_offer" name="Évalue l&#x27;offre">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_acheteur&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_evaluate_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_evaluation" name="Fin de l&#x27;évaluation de l&#x27;offre">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_acheteur&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_evaluate_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="start_pool_acheteur" name="Start Acheteur">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_evaluate_end" name="" sourceRef="task_evaluate_offer" targetRef="end_evaluation">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_1" name="" sourceRef="start_pool_acheteur" targetRef="task_evaluate_offer">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_evaluation_offres">
      <bpmndi:BPMNShape id="pool_fournisseur_di" bpmnElement="pool_fournisseur" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="480" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_acheteur_di" bpmnElement="pool_acheteur" isHorizontal="true">
        <dc:Bounds x="60" y="280" width="576" height="322" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_evaluation_di" bpmnElement="start_evaluation">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_submit_offer_di" bpmnElement="task_submit_offer">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_evaluate_offer_di" bpmnElement="task_evaluate_offer">
        <dc:Bounds x="280" y="452" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_evaluation_di" bpmnElement="end_evaluation">
        <dc:Bounds x="440" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_pool_acheteur_di" bpmnElement="start_pool_acheteur">
        <dc:Bounds x="120" y="386" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_submit_di" bpmnElement="flow_start_submit">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_evaluate_end_di" bpmnElement="flow_evaluate_end">
        <di:waypoint x="380" y="492" />
        <di:waypoint x="410" y="492" />
        <di:waypoint x="410" y="338" />
        <di:waypoint x="440" y="338" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="156" y="404" />
        <di:waypoint x="218" y="404" />
        <di:waypoint x="218" y="492" />
        <di:waypoint x="280" y="492" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_submit_evaluate_di" bpmnElement="flow_submit_evaluate">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="552" />
        <di:waypoint x="250" y="552" />
        <di:waypoint x="250" y="492" />
        <di:waypoint x="280" y="492" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>