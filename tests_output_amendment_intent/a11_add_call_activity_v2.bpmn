<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_recrutement"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_process_recrutement">
    <bpmn:participant id="pool_rh" name="Service RH" processRef="process_recrutement" />
  </bpmn:collaboration>
  <bpmn:process id="process_recrutement" name="Service RH" isExecutable="true">
    <bpmn:startEvent id="start_recrutement" name="Début du processus de recrutement">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_rh&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_recrutement</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_recrutement" name="Recrutement d&#x27;un nouvel employé">
      <bpmn:incoming>flow_start_recrutement</bpmn:incoming>
      <bpmn:outgoing>flow_recrutement_verification</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="task_verification_antecedents" name="Vérification des antécédents">
      <bpmn:documentation>calledElement: Processus standard de vérification des antécédents</bpmn:documentation>
      <bpmn:incoming>flow_recrutement_verification</bpmn:incoming>
      <bpmn:outgoing>flow_verification_preparation</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="task_preparation_arrivee" name="Préparation de l&#x27;arrivée du nouvel employé">
      <bpmn:incoming>flow_verification_preparation</bpmn:incoming>
      <bpmn:outgoing>flow_preparation_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_recrutement" name="Fin du processus de recrutement">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_rh&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_preparation_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_recrutement" name="" sourceRef="start_recrutement" targetRef="task_recrutement">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_recrutement_verification" name="" sourceRef="task_recrutement" targetRef="task_verification_antecedents">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_verification_preparation" name="" sourceRef="task_verification_antecedents" targetRef="task_preparation_arrivee">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_preparation_end" name="" sourceRef="task_preparation_arrivee" targetRef="end_recrutement">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_recrutement">
      <bpmndi:BPMNShape id="pool_rh_di" bpmnElement="pool_rh" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="896" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_recrutement_di" bpmnElement="start_recrutement">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_recrutement_di" bpmnElement="task_recrutement">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_verification_antecedents_di" bpmnElement="task_verification_antecedents">
        <dc:Bounds x="440" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_preparation_arrivee_di" bpmnElement="task_preparation_arrivee">
        <dc:Bounds x="600" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_recrutement_di" bpmnElement="end_recrutement">
        <dc:Bounds x="760" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_recrutement_di" bpmnElement="flow_start_recrutement">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_recrutement_verification_di" bpmnElement="flow_recrutement_verification">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="440" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_verification_preparation_di" bpmnElement="flow_verification_preparation">
        <di:waypoint x="540" y="130" />
        <di:waypoint x="600" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_preparation_end_di" bpmnElement="flow_preparation_end">
        <di:waypoint x="700" y="130" />
        <di:waypoint x="730" y="130" />
        <di:waypoint x="730" y="108" />
        <di:waypoint x="760" y="108" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>