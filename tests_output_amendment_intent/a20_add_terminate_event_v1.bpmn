<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_command"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_client_to_system" name="Commande envoyée au système" />
  <bpmn:collaboration id="Collaboration_process_command">
    <bpmn:participant id="pool_client" name="Client" processRef="pool_client_process" />
    <bpmn:participant id="pool_system" name="Système" processRef="pool_system_process" />
    <bpmn:messageFlow id="flow_client_to_system" name="Commande envoyée au système" sourceRef="task_client_place_order" targetRef="task_system_process_order" messageRef="Message_flow_client_to_system" />
  </bpmn:collaboration>
  <bpmn:process id="pool_client_process" name="Client" isExecutable="true">
    <bpmn:startEvent id="start_command" name="Commande passée">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_client&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:outgoing>flow_start_to_client</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_client_place_order" name="Passer une commande">
      <bpmn:incoming>flow_start_to_client</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_start_to_client" name="" sourceRef="start_command" targetRef="task_client_place_order">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_system_process" name="Système" isExecutable="true">
    <bpmn:task id="task_system_process_order" name="Traiter la commande">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_system&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_system_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_command_processed" name="Commande traitée">
      <bpmn:documentation>GAP: connexion automatique de secours — assigné automatiquement au pool &#x27;pool_system&#x27; (aucun poolId fourni par la génération) ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_system_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="start_pool_system" name="Start Système">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_system_to_end" name="" sourceRef="task_system_process_order" targetRef="end_command_processed">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_1" name="" sourceRef="start_pool_system" targetRef="task_system_process_order">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_command">
      <bpmndi:BPMNShape id="pool_client_di" bpmnElement="pool_client" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="480" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_system_di" bpmnElement="pool_system" isHorizontal="true">
        <dc:Bounds x="60" y="280" width="576" height="322" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_command_di" bpmnElement="start_command">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_client_place_order_di" bpmnElement="task_client_place_order">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_system_process_order_di" bpmnElement="task_system_process_order">
        <dc:Bounds x="280" y="452" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_command_processed_di" bpmnElement="end_command_processed">
        <dc:Bounds x="440" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_pool_system_di" bpmnElement="start_pool_system">
        <dc:Bounds x="120" y="386" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_client_di" bpmnElement="flow_start_to_client">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_system_to_end_di" bpmnElement="flow_system_to_end">
        <di:waypoint x="380" y="492" />
        <di:waypoint x="410" y="492" />
        <di:waypoint x="410" y="338" />
        <di:waypoint x="440" y="338" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="156" y="404" />
        <di:waypoint x="218" y="404" />
        <di:waypoint x="218" y="492" />
        <di:waypoint x="280" y="492" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_client_to_system_di" bpmnElement="flow_client_to_system">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="552" />
        <di:waypoint x="250" y="552" />
        <di:waypoint x="250" y="492" />
        <di:waypoint x="280" y="492" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="230" y="532" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>