<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_command_confirmation"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_pass_command_to_send_confirmation" name="flow_pass_command_to_send_confirmation" />
  <bpmn:collaboration id="Collaboration_process_command_confirmation">
    <bpmn:participant id="pool_client" name="Client" processRef="pool_client_process" />
    <bpmn:participant id="pool_system" name="Système" processRef="pool_system_process" />
    <bpmn:messageFlow id="flow_pass_command_to_send_confirmation" name="" sourceRef="task_pass_command" targetRef="task_send_confirmation_email" messageRef="Message_flow_pass_command_to_send_confirmation" />
  </bpmn:collaboration>
  <bpmn:process id="pool_client_process" name="Client" isExecutable="true">
    <bpmn:startEvent id="start_command" name="Commande passée par le client">
      <bpmn:outgoing>flow_start_to_pass_command</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_pass_command" name="Passer une commande">
      <bpmn:incoming>flow_start_to_pass_command</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_start_to_pass_command" name="" sourceRef="start_command" targetRef="task_pass_command">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_system_process" name="Système" isExecutable="true">
    <bpmn:sendTask id="task_send_confirmation_email" name="Envoyer email de confirmation">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_system&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_send_confirmation_to_end</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="end_confirmation_sent" name="Confirmation envoyée">
      <bpmn:incoming>flow_send_confirmation_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="start_pool_system" name="Start Système">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_send_confirmation_to_end" name="" sourceRef="task_send_confirmation_email" targetRef="end_confirmation_sent">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_1" name="" sourceRef="start_pool_system" targetRef="task_send_confirmation_email">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_command_confirmation">
      <bpmndi:BPMNShape id="pool_client_di" bpmnElement="pool_client" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="480" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_system_di" bpmnElement="pool_system" isHorizontal="true">
        <dc:Bounds x="60" y="280" width="576" height="322" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_command_di" bpmnElement="start_command">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_pass_command_di" bpmnElement="task_pass_command">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_confirmation_email_di" bpmnElement="task_send_confirmation_email">
        <dc:Bounds x="280" y="452" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_confirmation_sent_di" bpmnElement="end_confirmation_sent">
        <dc:Bounds x="440" y="320" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_pool_system_di" bpmnElement="start_pool_system">
        <dc:Bounds x="120" y="386" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_pass_command_di" bpmnElement="flow_start_to_pass_command">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_send_confirmation_to_end_di" bpmnElement="flow_send_confirmation_to_end">
        <di:waypoint x="380" y="492" />
        <di:waypoint x="410" y="492" />
        <di:waypoint x="410" y="338" />
        <di:waypoint x="440" y="338" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="156" y="404" />
        <di:waypoint x="218" y="404" />
        <di:waypoint x="218" y="492" />
        <di:waypoint x="280" y="492" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_pass_command_to_send_confirmation_di" bpmnElement="flow_pass_command_to_send_confirmation">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="552" />
        <di:waypoint x="250" y="552" />
        <di:waypoint x="250" y="492" />
        <di:waypoint x="280" y="492" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>