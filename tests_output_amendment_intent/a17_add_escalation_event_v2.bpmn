<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_complaint_management"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_start_to_treat" name="flow_start_to_treat" />
  <bpmn:message id="Message_flow_gateway_to_treat_msg" name="flow_gateway_to_treat_msg" />
  <bpmn:message id="Message_flow_gateway_to_escalade_msg" name="flow_gateway_to_escalade_msg" />
  <bpmn:collaboration id="Collaboration_process_complaint_management">
    <bpmn:participant id="pool_client" name="Client" processRef="pool_client_process" />
    <bpmn:participant id="pool_service_client" name="Service Client" processRef="pool_service_client_process" />
    <bpmn:messageFlow id="flow_start_to_treat" name="" sourceRef="task_deposit_complaint" targetRef="task_treat_complaint" messageRef="Message_flow_start_to_treat" />
    <bpmn:messageFlow id="flow_gateway_to_treat_msg" name="" sourceRef="gateway_escalade_notify" targetRef="task_treat_complaint" messageRef="Message_flow_gateway_to_treat_msg" />
    <bpmn:messageFlow id="flow_gateway_to_escalade_msg" name="" sourceRef="gateway_escalade_notify_2" targetRef="task_escalade" messageRef="Message_flow_gateway_to_escalade_msg" />
  </bpmn:collaboration>
  <bpmn:process id="pool_client_process" name="Client" isExecutable="true">
    <bpmn:startEvent id="start_event_complaint" name="Plainte déposée">
      <bpmn:outgoing>flow_start_to_deposit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_deposit_complaint" name="Déposer une plainte">
      <bpmn:incoming>flow_start_to_deposit</bpmn:incoming>
      <bpmn:outgoing>flow_deposit_to_check</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_check_amount" name="Vérifier le montant du litige">
      <bpmn:incoming>flow_deposit_to_check</bpmn:incoming>
      <bpmn:outgoing>flow_check_to_gateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_escalade" name="Montant &gt; 1000€ ?">
      <bpmn:incoming>flow_check_to_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_to_treat</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_to_escalade</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="gateway_escalade_notify" name="Transmettre : Non">
      <bpmn:documentation>GAP: connexion automatique de secours — tâche relais insérée automatiquement entre le gateway &#x27;gateway_escalade&#x27; et la pool &#x27;pool_service_client&#x27; : un gateway ne peut jamais porter directement un messageFlow inter-pool (cf. section 10.7 de SKILL.md). ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_gateway_to_treat</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="gateway_escalade_notify_2" name="Transmettre : Oui">
      <bpmn:documentation>GAP: connexion automatique de secours — tâche relais insérée automatiquement entre le gateway &#x27;gateway_escalade&#x27; et la pool &#x27;pool_service_client&#x27; : un gateway ne peut jamais porter directement un messageFlow inter-pool (cf. section 10.7 de SKILL.md). ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_gateway_to_escalade</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_start_to_deposit" name="" sourceRef="start_event_complaint" targetRef="task_deposit_complaint">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_deposit_to_check" name="" sourceRef="task_deposit_complaint" targetRef="task_check_amount">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_check_to_gateway" name="" sourceRef="task_check_amount" targetRef="gateway_escalade">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_to_treat" name="Non" sourceRef="gateway_escalade" targetRef="gateway_escalade_notify">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_to_escalade" name="Oui" sourceRef="gateway_escalade" targetRef="gateway_escalade_notify_2">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_service_client_process" name="Service Client" isExecutable="true">
    <bpmn:task id="task_escalade" name="Escalader au responsable régional">
      <bpmn:outgoing>flow_escalade_to_end_escalade</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_treat_complaint" name="Traiter la plainte">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_service_client&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_treat_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_event_complaint_handled" name="Plainte traitée">
      <bpmn:incoming>flow_treat_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_event_escalade" name="Plainte escaladée">
      <bpmn:incoming>flow_escalade_to_end_escalade</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="start_pool_service_client" name="Start Service Client">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_escalade_to_end_escalade" name="" sourceRef="task_escalade" targetRef="end_event_escalade">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_treat_to_end" name="" sourceRef="task_treat_complaint" targetRef="end_event_complaint_handled">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_1" name="" sourceRef="start_pool_service_client" targetRef="task_treat_complaint">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_complaint_management">
      <bpmndi:BPMNShape id="pool_client_di" bpmnElement="pool_client" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="960" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_service_client_di" bpmnElement="pool_service_client" isHorizontal="true">
        <dc:Bounds x="60" y="390" width="1216" height="366" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_event_complaint_di" bpmnElement="start_event_complaint">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_deposit_complaint_di" bpmnElement="task_deposit_complaint">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_amount_di" bpmnElement="task_check_amount">
        <dc:Bounds x="440" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_escalade_di" bpmnElement="gateway_escalade">
        <dc:Bounds x="600" y="90" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_escalade_di" bpmnElement="task_escalade">
        <dc:Bounds x="920" y="430" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_treat_complaint_di" bpmnElement="task_treat_complaint">
        <dc:Bounds x="280" y="606" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_complaint_handled_di" bpmnElement="end_event_complaint_handled">
        <dc:Bounds x="440" y="606" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_event_escalade_di" bpmnElement="end_event_escalade">
        <dc:Bounds x="1080" y="430" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_pool_service_client_di" bpmnElement="start_pool_service_client">
        <dc:Bounds x="120" y="540" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_escalade_notify_di" bpmnElement="gateway_escalade_notify">
        <dc:Bounds x="760" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_escalade_notify_2_di" bpmnElement="gateway_escalade_notify_2">
        <dc:Bounds x="760" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_to_deposit_di" bpmnElement="flow_start_to_deposit">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_deposit_to_check_di" bpmnElement="flow_deposit_to_check">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="440" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_check_to_gateway_di" bpmnElement="flow_check_to_gateway">
        <di:waypoint x="540" y="130" />
        <di:waypoint x="570" y="130" />
        <di:waypoint x="570" y="115" />
        <di:waypoint x="600" y="115" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_to_treat_di" bpmnElement="flow_gateway_to_treat">
        <di:waypoint x="650" y="115" />
        <di:waypoint x="705" y="115" />
        <di:waypoint x="705" y="130" />
        <di:waypoint x="760" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="110" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_to_escalade_di" bpmnElement="flow_gateway_to_escalade">
        <di:waypoint x="650" y="115" />
        <di:waypoint x="705" y="115" />
        <di:waypoint x="705" y="240" />
        <di:waypoint x="760" y="240" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="220" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_escalade_to_end_escalade_di" bpmnElement="flow_escalade_to_end_escalade">
        <di:waypoint x="1020" y="470" />
        <di:waypoint x="1050" y="470" />
        <di:waypoint x="1050" y="448" />
        <di:waypoint x="1080" y="448" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_treat_to_end_di" bpmnElement="flow_treat_to_end">
        <di:waypoint x="380" y="646" />
        <di:waypoint x="410" y="646" />
        <di:waypoint x="410" y="624" />
        <di:waypoint x="440" y="624" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="156" y="558" />
        <di:waypoint x="218" y="558" />
        <di:waypoint x="218" y="646" />
        <di:waypoint x="280" y="646" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_start_to_treat_di" bpmnElement="flow_start_to_treat">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="706" />
        <di:waypoint x="250" y="706" />
        <di:waypoint x="250" y="646" />
        <di:waypoint x="280" y="646" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_to_treat_msg_di" bpmnElement="flow_gateway_to_treat_msg">
        <di:waypoint x="860" y="130" />
        <di:waypoint x="890" y="130" />
        <di:waypoint x="890" y="706" />
        <di:waypoint x="250" y="706" />
        <di:waypoint x="250" y="646" />
        <di:waypoint x="280" y="646" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gateway_to_escalade_msg_di" bpmnElement="flow_gateway_to_escalade_msg">
        <di:waypoint x="860" y="240" />
        <di:waypoint x="890" y="240" />
        <di:waypoint x="890" y="470" />
        <di:waypoint x="920" y="470" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>