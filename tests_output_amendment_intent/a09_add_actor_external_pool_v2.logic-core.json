{
  "process": {
    "id": "process_order_fulfillment",
    "name": "Processus de commande de meubles",
    "documentation": "Processus de commande de meubles où un client passe une commande, le magasin la prépare, puis un transporteur externe livre les meubles chez le client."
  },
  "pools": [
    {
      "id": "pool_client",
      "name": "Client",
      "collapsed": false
    },
    {
      "id": "pool_magasin",
      "name": "Magasin",
      "collapsed": false
    }
  ],
  "nodes": [
    {
      "id": "start_received_order",
      "name": "Commande reçue",
      "type": "startEvent",
      "poolId": "pool_client",
      "eventDefinition": "none",
      "sourceProcessElement": "event_1"
    },
    {
      "id": "task_client_place_order",
      "name": "Passe une commande de meubles",
      "type": "task",
      "poolId": "pool_client",
      "sourceProcessElement": "activity_1"
    },
    {
      "id": "task_magasin_prepare_order",
      "name": "Prépare la commande",
      "type": "task",
      "poolId": "pool_magasin",
      "documentation": "GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool 'pool_magasin' ; cohérence métier non garantie, à vérifier.",
      "sourceProcessElement": "activity_2"
    },
    {
      "id": "call_transporteur_livraison",
      "name": "Appel au transporteur externe",
      "type": "callActivity",
      "poolId": "pool_magasin",
      "documentation": "calledElement: Processus de livraison standard",
      "sourceProcessElement": "activity_3"
    },
    {
      "id": "end_order_prepared",
      "name": "Commande préparée",
      "type": "endEvent",
      "poolId": "pool_magasin",
      "eventDefinition": "none"
    },
    {
      "id": "start_pool_magasin",
      "name": "Start Magasin",
      "type": "startEvent",
      "poolId": "pool_magasin"
    }
  ],
  "edges": [
    {
      "id": "flow_start_to_client_order",
      "type": "sequenceFlow",
      "source": "start_received_order",
      "target": "task_client_place_order",
      "sourceProcessElement": "relation_001"
    },
    {
      "id": "flow_client_order_to_magasin_prepare",
      "name": "Commande transmise au magasin",
      "type": "messageFlow",
      "source": "task_client_place_order",
      "target": "task_magasin_prepare_order",
      "sourceProcessElement": "relation_002"
    },
    {
      "id": "flow_magasin_prepare_to_call_transporteur",
      "type": "sequenceFlow",
      "source": "task_magasin_prepare_order",
      "target": "call_transporteur_livraison",
      "sourceProcessElement": "relation_003"
    },
    {
      "id": "flow_call_transporteur_to_end",
      "type": "sequenceFlow",
      "source": "call_transporteur_livraison",
      "target": "end_order_prepared",
      "sourceProcessElement": "relation_004"
    },
    {
      "id": "flow_1",
      "type": "sequenceFlow",
      "source": "start_pool_magasin",
      "target": "task_magasin_prepare_order"
    }
  ]
}