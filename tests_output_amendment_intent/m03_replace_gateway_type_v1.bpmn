<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_process_problem_resolution"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="BPMN-Agent" exporterVersion="1.0">
  <bpmn:message id="Message_flow_signal_evaluate" name="flow_signal_evaluate" />
  <bpmn:collaboration id="Collaboration_process_problem_resolution">
    <bpmn:participant id="pool_tenant" name="Locataire" processRef="pool_tenant_process" />
    <bpmn:participant id="pool_problem_management" name="Service de gestion des problèmes" processRef="pool_problem_management_process" />
    <bpmn:messageFlow id="flow_signal_evaluate" name="" sourceRef="task_signal_problem" targetRef="task_evaluate_problem" messageRef="Message_flow_signal_evaluate" />
  </bpmn:collaboration>
  <bpmn:process id="pool_tenant_process" name="Locataire" isExecutable="true">
    <bpmn:startEvent id="start_problem_signal" name="Problème signalé par le locataire">
      <bpmn:outgoing>flow_start_signal</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_signal_problem" name="Signaler un problème dans le logement">
      <bpmn:incoming>flow_start_signal</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_start_signal" name="" sourceRef="start_problem_signal" targetRef="task_signal_problem">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="pool_problem_management_process" name="Service de gestion des problèmes" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_plumbing" name="Plomberie">
        <bpmn:flowNodeRef>task_send_plumber</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_electricity" name="Électricité">
        <bpmn:flowNodeRef>task_send_electrician</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="task_evaluate_problem" name="Vérifier la nature du problème">
      <bpmn:documentation>GAP: connexion automatique de secours — rattaché automatiquement au flux interne du pool &#x27;pool_problem_management&#x27; ; cohérence métier non garantie, à vérifier.</bpmn:documentation>
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_evaluate_gateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="gateway_problem_type" name="Type de problème">
      <bpmn:incoming>flow_evaluate_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_plumbing_plumber</bpmn:outgoing>
      <bpmn:outgoing>flow_electricity_electrician</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="task_send_plumber" name="Envoyer un plombier">
      <bpmn:incoming>flow_plumbing_plumber</bpmn:incoming>
      <bpmn:outgoing>flow_plumber_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_send_electrician" name="Envoyer un électricien">
      <bpmn:incoming>flow_electricity_electrician</bpmn:incoming>
      <bpmn:outgoing>flow_electrician_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_problem_resolved" name="Problème résolu">
      <bpmn:incoming>flow_plumber_end</bpmn:incoming>
      <bpmn:incoming>flow_electrician_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="start_pool_problem_management" name="Start Service de gestion des problèmes">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow_evaluate_gateway" name="" sourceRef="task_evaluate_problem" targetRef="gateway_problem_type">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_plumbing_plumber" name="Problème de plomberie" sourceRef="gateway_problem_type" targetRef="task_send_plumber">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_electricity_electrician" name="Problème d&#x27;électricité" sourceRef="gateway_problem_type" targetRef="task_send_electrician">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_plumber_end" name="" sourceRef="task_send_plumber" targetRef="end_problem_resolved">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_electrician_end" name="" sourceRef="task_send_electrician" targetRef="end_problem_resolved">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_1" name="" sourceRef="start_pool_problem_management" targetRef="task_evaluate_problem">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_process_problem_resolution">
      <bpmndi:BPMNShape id="pool_tenant_di" bpmnElement="pool_tenant" isHorizontal="true">
        <dc:Bounds x="60" y="50" width="480" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pool_problem_management_di" bpmnElement="pool_problem_management" isHorizontal="true">
        <dc:Bounds x="60" y="280" width="900" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_plumbing_di" bpmnElement="lane_plumbing" isHorizontal="true">
        <dc:Bounds x="90" y="280" width="870" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_electricity_di" bpmnElement="lane_electricity" isHorizontal="true">
        <dc:Bounds x="90" y="470" width="870" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_problem_signal_di" bpmnElement="start_problem_signal">
        <dc:Bounds x="120" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_signal_problem_di" bpmnElement="task_signal_problem">
        <dc:Bounds x="280" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_evaluate_problem_di" bpmnElement="task_evaluate_problem">
        <dc:Bounds x="280" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_problem_type_di" bpmnElement="gateway_problem_type">
        <dc:Bounds x="440" y="80" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_plumber_di" bpmnElement="task_send_plumber">
        <dc:Bounds x="600" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_send_electrician_di" bpmnElement="task_send_electrician">
        <dc:Bounds x="600" y="510" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_problem_resolved_di" bpmnElement="end_problem_resolved">
        <dc:Bounds x="760" y="80" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_pool_problem_management_di" bpmnElement="start_pool_problem_management">
        <dc:Bounds x="120" y="166" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_signal_di" bpmnElement="flow_start_signal">
        <di:waypoint x="156" y="108" />
        <di:waypoint x="218" y="108" />
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_evaluate_gateway_di" bpmnElement="flow_evaluate_gateway">
        <di:waypoint x="380" y="250" />
        <di:waypoint x="410" y="250" />
        <di:waypoint x="410" y="105" />
        <di:waypoint x="440" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_plumbing_plumber_di" bpmnElement="flow_plumbing_plumber">
        <di:waypoint x="490" y="105" />
        <di:waypoint x="545" y="105" />
        <di:waypoint x="545" y="360" />
        <di:waypoint x="600" y="360" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="340" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_electricity_electrician_di" bpmnElement="flow_electricity_electrician">
        <di:waypoint x="490" y="105" />
        <di:waypoint x="545" y="105" />
        <di:waypoint x="545" y="550" />
        <di:waypoint x="600" y="550" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="525" y="530" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_plumber_end_di" bpmnElement="flow_plumber_end">
        <di:waypoint x="700" y="360" />
        <di:waypoint x="730" y="360" />
        <di:waypoint x="730" y="98" />
        <di:waypoint x="760" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_electrician_end_di" bpmnElement="flow_electrician_end">
        <di:waypoint x="700" y="550" />
        <di:waypoint x="730" y="550" />
        <di:waypoint x="730" y="98" />
        <di:waypoint x="760" y="98" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="156" y="184" />
        <di:waypoint x="218" y="184" />
        <di:waypoint x="218" y="250" />
        <di:waypoint x="280" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_signal_evaluate_di" bpmnElement="flow_signal_evaluate">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="410" y="130" />
        <di:waypoint x="410" y="310" />
        <di:waypoint x="250" y="310" />
        <di:waypoint x="250" y="250" />
        <di:waypoint x="280" y="250" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>